ve:scale-95`,children:I?e.jsx(st,{className:"w-5 h-5 animate-spin text-brand-primary"}):e.jsxs(e.Fragment,{children:[e.jsx(mc,{model:w,className:"w-4 h-4"}),e.jsx("span",{children:C?`${v("regenerate")} (${c})`:`${v("generate")} (${c})`})]})})]})})]},d.id)})]}),Oc=t=>[{id:"perspective_front",category:"architecture",angle:"Front Perspective",label:t("perspectiveFront")},{id:"perspective_left",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — 3/4 LEFT SIDE PERSPECTIVE VIEW: Position the camera at a three-quarter perspective angle showing both the front facade and the left side of the building.",label:t("perspectiveLeft")},{id:"perspective_left_elevation",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — FLAT LEFT ELEVATION VIEW: Position the camera directly facing the left side of the building in a perfect orthogonal, non-perspective flat elevation view. The left facade must fill the frame flatly. CRITICAL: You MUST completely replace the building massing with the left elevation geometry from the [LEFT] reference image. Do NOT retain the original building structure or perspective from the source image. ENVIRONMENT LOCK: Preserve 100% of the surrounding environment, landscaping, roads, and site context. FOREGROUND LOCK: The foreground is a wide, perfectly maintained green lawn extending across the entire bottom of the image. No road, no driveway crossing the foreground, no sidewalk, no pavement. The lawn should resemble a landscaped open green space beside the house. Preserve the site layout exactly as shown in Image 1: The road remains in front of the left elevation exactly where it is. Maintain the road width, curb, sidewalk, and driveway alignment. Keep the perimeter wall in its original position. Preserve the existing palm trees and landscape locations. Extend the same luxury residential neighborhood seen in Image 2 so it naturally surrounds the property from this new viewpoint. The road should match the quality of Image 2, with clean modern asphalt, realistic curbs, subtle texture variation, and physically accurate lighting. The surrounding landscape should seamlessly continue the same tropical environment as Image 2 while respecting the layout of Image 1. Keep every architectural element exactly as shown in Image 1. Do not redesign, move, resize, or add architectural features.",label:t("perspectiveLeftElevation")},{id:"perspective_right",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — 3/4 RIGHT SIDE PERSPECTIVE VIEW: Position the camera at a three-quarter perspective angle showing both the front facade and the right side of the building. ",label:t("perspectiveRight")},{id:"perspective_right_elevation",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — FLAT RIGHT ELEVATION VIEW: Position the camera directly facing the right side of the building in a perfect orthogonal, non-perspective flat elevation view. The right facade must fill the frame flatly. CRITICAL: You MUST completely replace the building massing with the right elevation geometry from the [RIGHT] reference image. Do NOT retain the original building structure or perspective from the source image. ENVIRONMENT LOCK: Preserve 100% of the surrounding environment, landscaping, roads, and site context. FOREGROUND LOCK: The foreground is a wide, perfectly maintained green lawn extending across the entire bottom of the image. No road, no driveway crossing the foreground, no sidewalk, no pavement. The lawn should resemble a landscaped open green space beside the house. Preserve the site layout exactly as shown in Image 1: The road remains in front of the right elevation exactly where it is. Maintain the road width, curb, sidewalk, and driveway alignment. Keep the perimeter wall in its original position. Preserve the existing palm trees and landscape locations. Extend the same luxury residential neighborhood seen in Image 2 so it naturally surrounds the property from this new viewpoint. The road should match the quality of Image 2, with clean modern asphalt, realistic curbs, subtle texture variation, and physically accurate lighting. The surrounding landscape should seamlessly continue the same tropical environment as Image 2 while respecting the layout of Image 1. Keep every architectural element exactly as shown in Image 1. Do not redesign, move, resize, or add architectural features.",label:t("perspectiveRightElevation")},{id:"perspective_back",category:"architecture",angle:"Rear Side Perspective",label:t("perspectiveBack")},{id:"perspective_top",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — TOP-DOWN / PLAN VIEW: Position the camera directly above the building, looking straight down at a 90-degree angle (nadir view). The roof plan and overall footprint must fill the frame. CRITICAL: You MUST completely replace the building massing with the top-down geometry from the [TOP] reference image. Do NOT retain the original building structure or any perspective from the source image. ENVIRONMENT LOCK: Preserve 100% of the surrounding environment, landscaping, roads, and site context visible from above. FOREGROUND LOCK: All vehicles and ground elements must remain in their exact original positions from the source image. 8k resolution.",label:t("perspectiveTop")},{id:"perspective_birds_eye",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — BIRD'S-EYE OBLIQUE VIEW: Position the camera high above and in front of the building at approximately a 45-degree bird's-eye, showing both the roof and the front/side facades in a three-quarter aerial perspective. CRITICAL: You MUST completely replace the building massing with the bird's-eye geometry from the [BIRDS_EYE] reference image. Do NOT retain the original building structure or ground-level perspective from the source image. ENVIRONMENT LOCK: Preserve 100% of the surrounding environment, landscaping, roads, and site context. FOREGROUND LOCK: All vehicles and ground elements must remain in their exact original positions from the source image. 8k resolution.",label:t("perspectiveBirdsEye")},{id:"entrance",category:"architecture",angle:"Professional architectural photo. Keep 100% massing and materials. No new details. View: Close-up focused on the main entrance and lobby area.. 8k resolution. IMPORTANT: Generate one single, unified, full-frame image. Do not create a grid, collage, tiles, or mosaic composition",label:t("cameraEntrance"),icon:"M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z",previewId:"1o2ejFn_-8O3sys5en9kdX378n3QOBU84"},{id:"focus_facade",category:"architecture",angle:"Professional architectural quad-view composite of facade details. Show 4 different Micro-close-up perspectives in one frame focusing strictly on building skin textures, wall materials, and detailed architectural joints.",label:t("cameraFacadeDetail"),icon:"M4 4h7v7H4V4zM13 4h7v7h-7V4zM4 13h7v7H4v-7zM13 13h7v7H4v-7z",previewId:"1rLQ2xQp7PNmqMQXQwDyoquD9Dxt0Sn32"},{id:"arc_worms_eye",category:"architecture",angle:"Professional architectural photo. Keep 100% massing and materials. No new details.Dramatic low-angle worm's eye view of the building exterior looking upwards.",label:t("cameraInsideWormEye"),icon:"M4.5 12.75l7.5-7.5 7.5 7.5m-15 6l7.5-7.5 7.5 7.5",previewId:"1aPLztm-kwSO9KmiSk3ucrZJ3VKLj5BZL"},{id:"perspective_detail",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — ARCHITECTURAL DETAIL CLOSE-UP: Zoom the camera tightly into the specific architectural detail or building fragment shown in the [DETAIL] reference image. The framed detail must fill at least 80% of the output image. Do NOT show the entire building or a wide-angle view. ADOPT the exact cropping, angle, and focal point from the [DETAIL] reference image. ENVIRONMENT LOCK: Preserve the lighting, sky, and ambient conditions from the primary source image. FOREGROUND LOCK: All vehicles, street furniture, and ground elements visible in the crop must remain in their exact original positions. 8k resolution.",label:t("perspectiveDetail")},{id:"perspective_last_view",category:"architecture",angle:"PERSPECTIVE TRANSFORMATION: Shift the camera and building geometry to strictly match the [LAST_VIEW] reference image. ENVIRONMENT PRESERVATION: Maintain 100% of the environment, landscaping, sky, site context, and lighting from the primary source image. FOREGROUND CONSISTENCY: Strictly retain the original position, scale, and identity of vehicles and street elements from the source image—do not move or relocate the car. Ignore the building structure from the source image, only adopting the architectural perspective and massing provided in [LAST_VIEW].",label:t("perspectiveLastView")},{id:"perspective_environment",category:"architecture",angle:"CRITICAL SCENE INTEGRATION: The [ENVIRONMENT] reference image contains the EXACT architectural geometry, materials, and layout you must render. You MUST completely IGNORE and DELETE any building geometry from the primary source image. The primary source image provides ONLY the background, sky, and landscaping environment. You must wrap the primary image's environment around the [ENVIRONMENT] reference's geometry perfectly, without altering the reference's structure. 8k resolution, photorealistic.",label:t("hubEnvironment")},{id:"perspective_standard_grid",category:"architecture",angle:"Based on the uploaded images, generate an ultra-realistic 3x3 exterior visualization grid collage. Only generate the mosaic collage itself with no text, logo, watermark, or graphic overlay. The space is fixed, with the exact same architecture, exterior furnishings, landscaping, materials, lighting, and environment across all frames. Preserve the exact same house design, roof shape, façade proportions, wood cladding, windows, driveway, trees, garden layout, and realistic scale from the uploaded reference images. Use high-end DSLR architectural photography style with a 24–35mm lens, realistic natural daylight, soft warm sunlight, cinematic shadows, and premium real-estate editorial quality. The camera shot order is as follows: Row 1: Three wide shots from different angles, with the original main front perspective in the center. The 3/4 Left Side Perspective and 3/4 Right Side Perspective images should be alternative wide-angle perspectives of the same house while maintaining identical architecture and environment. Row 2: Two images only: Left: The main hero front elevation shot matching the uploaded reference image. Right: Generate a realistic 45-degree bird's-eye view photograph based on the provided site plan. The image must fully represent the entire scene and surrounding environment while maintaining the original site shape and image proportions. It should depict realistic details of vegetation and landscape, use a wide-angle lens to create a sense of space, and the final image must possess a high-quality, realistic photographic feel. Row 3: Three detail shots from different perspectives focusing on realistic architectural elements such as wood cladding, wall textures, window framing, lighting fixtures, landscaping, gravel, greenery, and material connections. Maintain strict visual consistency across all images: same architecture same layout and structure same material palette same lighting and time of day same realistic scale and environment Use ultra-realistic architectural photography with subtle depth of field, realistic lens behavior, physically accurate lighting, and clean premium residential atmosphere. Avoid CGI appearance, fantasy styling, or redesigning the building.",label:t("perspectiveStandardGrid"),previewId:"1nmV0D5BtMBUmBuNCO10H0hFcOMPtzP_k"},{id:"perspective_two_row_grid",category:"architecture",angle:"Based on the uploaded images, generate an ultra-realistic 2-row exterior visualization grid collage. Only generate the mosaic collage itself with no text, logo, watermark, or graphic overlay.The space is fixed, with the exact same architecture, exterior furnishings, landscaping, materials, lighting, and environment across all frames. Preserve the exact same house design, roof shape, façade proportions, wood cladding, windows, driveway, trees, garden layout, and realistic scale from the uploaded reference images. Use high-end DSLR architectural photography style with a 24–35mm lens, realistic natural daylight, soft warm sunlight, cinematic shadows, and premium real-estate editorial quality. The camera shot order is as follows: Row 1: Three wide shots from different angles, with the original main front perspective in the center. The 3/4 Left Side Perspective and 3/4 Right Side Perspective of the same house while maintaining identical architecture and environment. Row 2: Two images only: Left: The main hero front elevation shot matching the uploaded reference image. Right: Generate a realistic 45-degree bird's-eye view photograph based on the provided site plan. The image must fully represent the entire scene and surrounding environment while maintaining the original site shape and image proportions. It should depict realistic details of vegetation and landscape, use a wide-angle lens to create a sense of space, and the final image must possess a high-quality, realistic photographic feel. Maintain strict visual consistency across all images: same architecture same layout and structure same material palette same lighting and time of day same realistic scale and environment Use ultra-realistic architectural photography with subtle depth of field, realistic lens behavior, physically accurate lighting, and clean premium residential atmosphere. Avoid CGI appearance, fantasy styling, or redesigning the building.",label:t("perspectiveTwoRowGrid"),previewId:"1zHSxpUIkZKjfniLAceCp2rmZrCmFT6Mv"},{id:"perspective_front_row_only",category:"architecture",angle:"Based on the uploaded images, generate an ultra-realistic exterior visualization collage featuring 3 dynamic wide-angle exterior perspective views. The composition, framing, panel sizing, and layout should be creatively and dynamically arranged by the AI in a random, balanced editorial mosaic collage (not constrained to a single row). Only generate the mosaic collage itself with no text, logo, watermark, or graphic overlay. The space is fixed, with the exact same architecture, exterior furnishings, landscaping, materials, lighting, and environment across all frames. Preserve the exact same house design, roof shape, façade proportions, wood cladding, windows, driveway, trees, garden layout, and realistic scale from the uploaded reference images. Use high-end DSLR architectural photography style with a 24–35mm lens, realistic natural daylight, soft warm sunlight, cinematic shadows, and premium real-estate editorial quality. Feature 3 dynamic exterior perspectives of the house—including the main front perspective, 3/4 Left Side Perspective, and 3/4 Right Side Perspective—creatively arranged across varied frame proportions while maintaining identical architecture and environment. Maintain strict visual consistency across all images: same architecture, same layout and structure, same material palette, same lighting and time of day, same realistic scale and environment. Use ultra-realistic architectural photography with subtle depth of field, realistic lens behavior, physically accurate lighting, and clean premium residential atmosphere. Avoid CGI appearance, fantasy styling, or redesigning the building.",label:t("perspectiveFrontRowOnly"),previewId:"1knTDgMm4LjboA1nsubA5Tj7JOWo78swM"},{id:"perspective_material_details_grid",category:"architecture",angle:"Based on the uploaded images, generate an ultra-realistic architectural visualization collage featuring 3 architectural material detail views. The composition, framing, and layout should be creatively and dynamically arranged by the AI (not constrained to a single row). Only generate the mosaic collage itself with no text, logo, watermark, or graphic overlay. The space is fixed, with the exact same architecture, exterior furnishings, landscaping, materials, lighting, and environment across all frames. Preserve the exact same house design, roof shape, façade proportions, wood cladding, windows, driveway, trees, garden layout, and realistic scale from the uploaded reference images. Use high-end DSLR architectural macro photography style with a 50–85mm lens, realistic natural daylight, soft warm sunlight, cinematic shadows, and premium real-estate editorial quality. Capture 3 different close-up detail perspectives randomly and dynamically selected from the building—such as wood cladding, wall textures, masonry finishes, window framing, glass reveals, architectural lighting fixtures, or landscape material transitions. Maintain strict visual consistency across all frames: same architecture, same layout and structure, same material palette, same lighting and time of day, same realistic scale and environment. Use ultra-realistic architectural photography with subtle depth of field, realistic lens behavior, physically accurate lighting, and clean premium residential atmosphere. Avoid CGI appearance, fantasy styling, or redesigning the building.",label:t("perspectiveMaterialDetailsGrid"),previewId:"1cxhCZaCYjtVGycB3MEatq8E0fEusrm_D"},{id:"perspective_plants_details_grid",category:"architecture",angle:"Based on the uploaded images, generate an ultra-realistic architectural landscaping collage featuring 3 botanical and greenery detail views focused on the trees, plants, and shrubs on scene. The composition, framing, and layout should be creatively and dynamically arranged by the AI (not constrained to a single row). Only generate the mosaic collage itself with no text, logo, watermark, or graphic overlay. The space is fixed, with the exact same architecture, exterior plantings, trees, shrubs, flower beds, lawn, materials, lighting, and environment across all frames. Preserve the exact same house design, facade backdrop, courtyard planting layout, tree species, and realistic human scale from the uploaded reference images. Use high-end DSLR architectural garden and botanical photography style with a 50–85mm prime lens, shallow depth of field (f/1.8–f/2.8) creating soft, creamy background bokeh framing the architecture behind the greenery, realistic natural daylight, gentle dappled sunlight filtering through leaves, and soft organic shadows. Capture 3 different close-up and medium-detail botanical perspectives randomly and dynamically selected across the scene—such as lush garden shrubs and ornamental grasses framing a pathway, close-up textured foliage and tree leaves with sun flares and dew drops, elegant potted planters and layered flower beds beside the patio, or sculptural tree canopies and climbing greenery against the building facade. Maintain strict visual consistency across all frames: same landscape layout, identical plant species and colors, same architecture, same lighting, and same time of day. Use ultra-realistic nature and architectural photography with physically accurate lighting, delicate leaf translucency, authentic bark textures, and clean luxury residential garden atmosphere. Avoid CGI appearance, fantasy flowers, or altering the property layout.",label:t("perspectivePlantsDetailsGrid"),previewId:"1sk5Um6ClM5MiKXajnorOahi-1Y1sewRL"},{id:"perspective_aerial_site",category:"architecture",angle:"MANDATORY CAMERA DIRECTION — BIRD'S-EYE OBLIQUE VIEW: Position the camera high above and in front of the building at approximately a 45-degree bird's-eye, showing both the roof and the front/side facades in a three-quarter aerial perspective. CRITICAL: You MUST completely replace the building massing with the bird's-eye geometry from the [BIRDS_EYE] reference image. Do NOT retain the original building structure or ground-level perspective from the source image. STRICT FIDELITY: Keep the building's exact geometry, roof forms, proportions, and materials. No redesign. AERIAL SITE EXPANSION: From this bird's-eye viewpoint, logically imagine and extend the full surroundings that would exist around this building. Expand terrain, ground surfaces, access paths, driveways, fences, neighboring context, vegetation, and open space far beyond the base image edges. ENVIRONMENT: Natural, believable context matching the architecture's style and region. SCALE: Very wide bird's-eye view. Building small but central in the frame, with expansive site context filling the rest. FOREGROUND LOCK: All vehicles and ground elements must remain in their exact original positions from the source image. Ultra-realistic aerial drone photography, 8k resolution, professional architectural presentation. IMPORTANT: Generate one single, unified, full-frame image. Do not create a grid, collage, tiles, or mosaic composition.",label:t("perspectiveAerialSite")}],Pc=t=>{const{t:a}=t,r=Oc(a),i=r.filter(o=>Ln.includes(o.id)),s=r.filter(o=>!Ln.includes(o.id));return e.jsxs("div",{className:"flex flex-col gap-12 mb-8",children:[i.length>0&&e.jsxs("div",{className:"space-y-6",children:[e.jsxs("div",{className:"flex items-center gap-4 px-2",children:[e.jsx("div",{className:"h-[1px] flex-1 bg-brand-primary/20"}),e.jsxs("div",{className:"flex items-center gap-2",children:[e.jsx("div",{className:"p-1 px-3 bg-brand-primary/10 rounded-full border border-brand-primary/20",children:e.jsx("span",{className:"text-[10px] font-black text-brand-primary uppercase tracking-widest",children:a("neuralViewsTitle")})}),e.jsx(Fe,{className:"w-4 h-4 text-brand-primary animate-pulse"})]}),e.jsx("div",{className:"h-[1px] flex-1 bg-brand-primary/20"})]}),e.jsx(Be,{...t,configs:i})]}),s.length>0&&e.jsxs("div",{className:"space-y-6",children:[e.jsxs("div",{className:"flex items-center gap-4 px-2",children:[e.jsx("div",{className:"h-[1px] flex-1 bg-white/5"}),e.jsx("div",{className:"p-1 px-3 bg-white/5 rounded-full border border-white/5",children:e.jsx("span",{className:"text-[10px] font-black text-text-secondary uppercase tracking-widest opacity-60",children:a("standardViewsTitle")})}),e.jsx("div",{className:"h-[1px] flex-1 bg-white/5"})]}),e.jsx(Be,{...t,configs:s,hideIcons:!0})]})]})},Dc=t=>[{id:"int_quad",category:"interior",angle:"Interior Quad View Presentation",label:t("cameraInsideQuad"),icon:"M4 4h7v7H4V4zM13 4h7v7h-7V4z"},{id:"int_closeup",category:"interior",angle:"Take a great close-up that shows one of the details of this image, use depth of field for blurring, add a bokeh effect, show the details clearly, and add some small elements with fine details.",label:t("cameraInsideDetail"),icon:"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"},{id:"int_functional",category:"interior",angle:"Highlazight the functional utility zones of the space (workstations, reading corners, utility areas, or storage logic). Focus on spatial flow and usable surfaces.",label:t("cameraInsideFunctional"),icon:"M12 8v13m0-13V6a2 2 0 114 0v2m-4 0H8a2 2 0 00-2 2v3m9-3h3m-3 0h-3m3 0v10M8 12h3"},{id:"int_isometric",category:"interior",angle:"A professional interior design mood board presentation sheet featuring a high-end 3D isometric cutaway view of a interior space. The central render is ultra-realistic and photorealistic, with soft studio lighting, accurate shadows, refined proportions, and premium materials.Surrounding the main render are floating circular close-up material swatches (wood veneer, marble, fabric, metal) placed organically around the scene — no lines, no connections, no labels, no icons, no symbols.At the bottom, include small cinematic vignette renders showing fine details such as cabinetry joinery, drawer interiors, shelving texture, and integrated lighting.Clean white background with very subtle, low-opacity architectural pencil sketch textures barely visible in the background.Luxury interior visualization, editorial mood board composition, minimal design language, neutral palette, soft contrast, high clarity, no text, no lines, no UI elements anywhere in the image.",label:t("cameraInsideIsometric"),icon:"M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"},{id:"int_moodboard",category:"interior",angle:"Create a high-end interior design material moodboard using only the materials present in the 3D scene. Arrange the samples in an artistic, layered composition similar to luxury architectural boards, with realistic textures, shadows, and soft studio lighting. Include stone, wood, fabric, metal, and color swatches exactly as they appear in the scene, presented as physical material tiles and samples. Use a refined neutral background, elegant styling, and balanced layout to achieve a premium, photorealistic moodboard aesthetic",label:t("cameraInteriorMoodboard"),icon:"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"},{id:"int_moodboard_mag",category:"interior",angle:"Based on the uploaded interior renderings, a professional-looking mood board with horizontal layout for interior materials and furniture is generated. Instead of showcasing three-dimensional perspective, the layout adopts a flat, high-end magazine style. The background is uniformly clean, with ample white space, using off-white or light-colored textured paper. The left side of the board features four vertically arranged long strips of material colors, showcasing key material textures extracted from the original design (such as marble, wood veneer, fabric, or leather). Below each material color is a brief design description, and the left side is separated from other content by black vertical lines. The main area of the board visually deconstructs and independently cuts out each piece of furniture and interior design item (such as sofas, armchairs, coffee tables, lamps, rugs, and artwork) from the original image. Each item is accompanied by a hand-drawn annotation arrow and a minimalist text label indicating its name and basic information. The overall layout is elegant and minimalist, titled 'Interior Design Guide' at the top, following the highest standards of international interior design presentation. No additional three-dimensional perspective, no shadows, no noise, only a clear, professional presentation board.",label:t("moodBoard"),icon:"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"},{id:"int_moodboard_flatlay",category:"interior",angle:"Based on the uploaded interior renderings, create a professional-grade design mood board. The overall presentation must be a high-quality flat-lay photograph, using a top-down perspective. All elements in the image should be presented as highly realistic and tactile physical samples, not digital collages. The background should be clean and neutral. Please analyze the key information in the uploaded renderings and transform it into the following physical objects for artistic combination: Materialization of Color and Material: Extract the primary and secondary colors and create solid color cards with depth. Identify the key materials in the image (e.g., marble with specific textures, oak flooring, brushed metal, concrete, etc.) and represent them as small slabs, tiles, or slices with realistic texture details. Transform textiles (e.g., linen sofas, velvet curtains, wool rugs) into folded or rolled-up fabric samples and small rug samples, emphasizing their fabric texture and drape. Abstraction of Style and Elements: Abstract the iconic furniture styles or lighting fixtures in the image into representative geometric models or material accessories (e.g., using a round concrete block to represent a certain type of lighting fixture, or a bunch of dried plants to represent a decorating style). Composition and Atmosphere: Use natural, soft lighting to emphasize the texture and feel of all material samples. Arrange these color swatches, material boards, fabrics, and accessories in an artistic, staggered, and layered manner. The composition should be balanced and aesthetically pleasing, accurately capturing and reproducing the design theme, atmosphere, and style of the original interior space.",label:t("cameraMoodBoardFlatlay"),icon:"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"},{id:"int_axonometric_analysis",category:"interior",angle:"Based on the uploaded images, an axonometric analysis diagram showcasing the interior space and soft furnishings is generated, meticulously and accurately presenting its internal structure. The structural names and functional descriptions are annotated in English. The overall layout combines professionalism and visual logic, presenting a clear and neat analytical diagram against a white background.",label:t("cameraInteriorAxonometricAnalysis"),icon:"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"},{id:"int_style_quad",category:"interior",angle:"The uploaded images were converted into four style versions, while keeping all original hard and soft furnishing elements in their exact positions and general shapes. Only their materials, colors, and details were changed to reflect each style: Neo-Chinese, French, Wabi-sabi, and Minimalist. The original composition, spatial structure, wall, ceiling, floor, column, and furniture layout and size were maintained to ensure that each style was authentic, aesthetically pleasing, and professionally rendered.",label:t("cameraInteriorStyleQuadComparison"),icon:"M4 4h7v7H4V4zM13 4h7v7h-7V4zM4 13h7v7H4v-7zM13 13h7v7H4v-7z"},{id:"int_grid_3x3",category:"interior",angle:"Based on the images I uploaded, generate a 3x3 indoor visualization grid. Only generate the mosaic; no text needs to be added. The image ratio is 1:1. The space is fixed, with the same interior furnishings. The camera shot order is as follows: Row 1: Three wide shots from different angles, with the original image in the center; Row 2: Three medium shots from different angles; Row 3: Detail 1, Detail 2, and Detail 3 (these three details need to be shown from different perspectives).",label:t("cameraInteriorGrid3x3"),icon:"M3 3h4v4H3V3zm7 0h4v4h-4V3zm7 0h4v4h-4V3zM3 10h4v4H3v-4zm7 0h4v4h-4v-4zm7 0h4v4h-4v-4zM3 17h4v4H3v-4zm7 0h4v4h-4v-4zm7 0h4v4h-4v-4z"},{id:"int_product_board",category:"interior",angle:"Create a professional, high-resolution product presentation board for the furniture item in the reference image. The final output must be a single 3:2 or 4:3 image using a minimalist industrial design style with neutral tones and modern sans-serif typography. Divide the composition into two distinct sections separated by thin vertical lines: Left Panel (PRODUCT VIEWS): Titled 'PRODUCT VIEWS,' display the item from three consistent orthographic angles: Top View, Side View, and Front View. Strict Rule: Maintain the exact geometry, design, and proportions of the original object with 100% accuracy. Do not modify or add any design elements. Right Panel (MATERIAL PANEL): Titled 'MATERIAL PANEL,' featuring a clean material swatch grid. Strict Rule: Automatically identify and extract only the textures/materials visible in the input image. Display each texture as a square swatch with its English name below it. Do not use arrows, guide lines, or invent new materials. Environment: Use a neutral light background with soft studio lighting. Quality: High-detail architectural rendering with crisp textures. Color Palette: Strictly neutral tones to maintain a professional catalog aesthetic. No Modifications: The furniture geometry is locked; do not alter the shape or structure of the reference piece.",label:t("cameraInteriorProductBoard"),icon:"M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"},{id:"int_worms_eye",category:"interior",angle:"Dramatic low-angle worm's eye view looking up into the interior volume. Emphasize ceiling details, lighting fixtures, and vertical space. Cinematic architectural photography with golden ratio composition..",label:t("cameraInsideWormEye"),icon:"M4.5 12.75l7.5-7.5 7.5 7.5m-15 6l7.5-7.5 7.5 7.5"},{id:"int_character_integration",category:"interior",angle:"Cinematic lifestyle photography. A human character seamlessly integrated into the scene, naturally interacting with the space in realistic scale. Beautiful depth of field, keeping the subject in sharp focus while the background naturally blurs. Let the composition and framing be dynamic and unscripted.",label:t("cameraInteriorCharacter"),icon:"M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"},{id:"int_character_close_up",category:"interior",angle:"Close-up of everyday activity within the environment, natural interaction and cinematic depth of field.",label:t("cameraInteriorCharacterCloseUp"),icon:"M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"}],Uc=t=>{const{t:a}=t,r=Dc(a),i=["int_product_board"],s=["int_grid_3x3","int_quad"],o=["int_style_quad"],c=["int_axonometric_analysis"],l=["int_isometric","int_moodboard","int_moodboard_mag","int_moodboard_flatlay"],u=["int_character_integration","int_character_close_up"],g=r.filter(d=>i.includes(d.id)),m=r.filter(d=>s.includes(d.id)),p=r.filter(d=>o.includes(d.id)),v=r.filter(d=>c.includes(d.id)),T=r.filter(d=>l.includes(d.id)),L=r.filter(d=>u.includes(d.id)),w=r.filter(d=>!l.includes(d.id)&&!c.includes(d.id)&&!o.includes(d.id)&&!s.includes(d.id)&&!i.includes(d.id)&&!u.includes(d.id));return e.jsxs("div",{className:"flex flex-col gap-12 mb-8"