ិយាកាស (៣ ឈុត)"},storyboardRawLandSitePrep:{en:"Raw Land & Site Preparation (3 Shots)",kh:"ពីដីទំនេរដល់ការរៀបចំការដ្ឋាន (៣ ឈុត)"},storyboardBlueprintToFoundation:{en:"Blueprint to Foundation (3 Shots)",kh:"ពីប្លង់មេដល់គ្រឹះសំណង់ (៣ ឈុត)"},storyboardStructureToReality:{en:"Structure to Reality (3 Shots)",kh:"ពីគ្រោងសំណង់ទៅជាស្នាដៃពិត (៣ ឈុត)"},storyboardDriveUpCarApproach:{en:"Drive-Up Car Approach (3 Shots)",kh:"ប្លង់បើករថយន្តមកកាន់ផ្ទះ (៣ ឈុត)"},storyboardPropertyInfographic:{en:"Location & Boundary Infographic (3 Shots)",kh:"ប្លង់ព័ត៌មានទីតាំង និងព្រំដី (៣ ឈុត)"},storyboardHostPropertyReview:{en:"Property Review Host Tour (3 Shots)",kh:"ប្លង់ពិនិត្យផ្ទះដោយពិធីករ (៣ ឈុត)"},storyboardArchitectClientReview:{en:"Architect & Client Review (3 Shots)",kh:"ប្លង់ពិនិត្យរវាងស្ថាបត្យករ និងម្ចាស់ផ្ទះ (៣ ឈុត)"},storyboardHomebuyerCoupleTour:{en:"Homebuyer First Impression Tour (3 Shots)",kh:"ប្លង់ចំណាប់អារម្មណ៍ដំបូងរបស់អ្នកទិញផ្ទះ (៣ ឈុត)"},storyboard4ShotDirector:{en:"4-Shot Video Script",kh:"ប្លង់វីដេអូ ៤ ឈុត"},storyboard2ShotDirector:{en:"2-Shot Video Script",kh:"ប្លង់វីដេអូ ២ ឈុត"},storyboardChatGptOnlyTitle:{en:"Powered Exclusively by ChatGPT Image 2",kh:"ដំណើរការផ្តាច់មុខដោយ ChatGPT Image 2"},storyboardChatGptOnlyBadge:{en:"AI Director",kh:"AI អ្នកដឹកនាំរឿង"},storyboardChatGptOnlyDesc:{en:"Story Board script generation automatically uses the ChatGPT Image 2 model for cinematic multi-shot layouts.",kh:"ការបង្កើតប្លង់រឿងប្រើប្រាស់ម៉ូដែល ChatGPT Image 2 ដោយស្វ័យប្រវត្តិសម្រាប់ប្លង់ភាពយន្តច្រើនឈុត។"},storyboardChatGptActive:{en:"ChatGPT 2 Active",kh:"ChatGPT 2 កំពុងដំណើរការ"},storyboard4Shot:{en:"4-Shot Sequence",kh:"ឈុត ៤ ប្លង់"},storyboardDayNight:{en:"Day to Night",kh:"ពីថ្ងៃទៅយប់"},storyboardMotion:{en:"Motion Sequence",kh:"ចលនាកាមេរ៉ា"},storyboardJourney:{en:"Arrival Journey",kh:"ដំណើរមកដល់"},interiorOnlyTooltip:{en:"Working for interior only",kh:"សម្រាប់តែផ្នែកខាងក្នុងប៉ុណ្ណោះ"},aiCinematicEngine:{en:"AI Cinematic Engine",kh:"ម៉ាស៊ីន AI ភាពយន្ត"},veoFastDesc:{en:"Fast rendering (~$0.80 cost)",kh:"Render លឿន (~$0.80 តម្លៃ)"},veoCinematicDesc:{en:"High fidelity (~$2.25 cost)",kh:"គុណភាពខ្ពស់ (~$2.25 តម្លៃ)"},staticCinematic:{en:"Static Cinematic",kh:"ភាពយន្តថេរ"},slowDollyIn:{en:"Slow Dolly-In",kh:"ចុះជិតយឺត"},slowDollyOut:{en:"Slow Dolly-Out",kh:"ថយក្រោយយឺត"},panLeft:{en:"Pan Left",kh:"ប្រមូលឆ្វេង"},panRight:{en:"Pan Right",kh:"ប្រមូលស្តាំ"},tiltUp:{en:"Tilt Up",kh:"រំកិលឡើង"},tiltDown:{en:"Tilt Down",kh:"រំកិលចុះ"},arcOrbit:{en:"Arc / Orbit",kh:"ធ្នូ / វិល"},sideTracking:{en:"Side Tracking",kh:"តាមចំហៀង"},aerialOrbit:{en:"Aerial Orbit",kh:"វិលពីលើ"},landscape:{en:"Landscape (16:9)",kh:"ទេសភាព (១៦:៩)"},portrait:{en:"Portrait (9:16)",kh:"បញ្ឈរ (៩:១៦)"},square:{en:"Square (1:1)",kh:"ការេ (១:១)"},lastFrameOptional:{en:"Last Frame (Optional)",kh:"ស៊ុមចុងក្រោយ (ស្រេចចិត្ត)"},clickToUploadLastFrame:{en:"Click to upload last frame",kh:"ចុចដើម្បីបញ្ចូលស៊ុមចុងក្រោយ"},videoTransitionDesc:{en:"Video will transition from start to end",kh:"វីដេអូនឹងផ្លាស់ប្តូរពីដើមទៅចុង"},lastFrameTip:{en:"💡 Optional: Upload a target last frame. Video will smoothly transition from start to end image.",kh:"💡 ស្រេចចិត្ត: បញ្ចូលស៊ុមចុងក្រោយគោលដៅ។ វីដេអូនឹងផ្លាស់ប្តូររលូនពីរូបភាពដើមទៅចុង។"},costCalculation:{en:"Cost Calculation",kh:"គណនាតម្លៃ"},creditsUnit:{en:"Credits",kh:"ពិន្ទុ"},processingSequence:{en:"Generating...",kh:"កំពុងបង្កើត..."},synthesizeCinematicVideo:{en:"Generate Video",kh:"បង្កើតវីដេអូ"},aiVideoPrompt:{en:"AI Video Prompt",kh:"ការពណ៌នាវីដេអូ AI"},analyzeStoryboard6Shot:{en:"Analyze 6-Shot (5c)",kh:"វិភាគ 6 ប្លង់ (5c)"},analyzingStoryboard:{en:"Analyzing (5c)...",kh:"កំពុងវិភាគ (5c)..."},enhanceTransitionPrompt:{en:"Magic Enhance Transition",kh:"វិភាគកែលម្អ Transition"},enhancingTransitionPrompt:{en:"Enhancing Transition...",kh:"កំពុងវិភាគកែលម្អ Transition..."},expandFullPrompt:{en:"Expand",kh:"ពង្រីក"},collapseFullPrompt:{en:"Collapse",kh:"បង្រួម"},readyForAnimation:{en:"Ready for Animation",kh:"ត្រៀមរួចសម្រាប់អាណ៊ីម៉ាស្យុង"},proEngineRequired:{en:"Pro Engine Required",kh:"ត្រូវការម៉ាស៊ីន Pro"},proEngineDesc:{en:"Cinematic video synthesis uses massive compute power from the",kh:"ការបង្កើតវីដេអូភាពយន្តប្រើថាមពលគណនាធំពី"},proEngineDesc2:{en:"neural cores.",kh:"ស្នូលសរសៃប្រសាទ។"},upgradeToPro:{en:"Upgrade to Pro",kh:"ដំឡើងជំនាន់ទៅ Pro"},confirmVideoGeneration:{en:"Confirm Video Generation",kh:"បញ្ជាក់ការបង្កើតវីដេអូ"},reviewGenerationDetails:{en:"Review Generation Details",kh:"ពិនិត្យព័ត៌មានលម្អិតការបង្កើត"},videoModel:{en:"Video Model",kh:"ម៉ូដែលវីដេអូ"},totalCost:{en:"Total Cost",kh:"តម្លៃសរុប"},currentBalance:{en:"Current Balance",kh:"សមតុល្យបច្ចុប្បន្ន"},afterGeneration:{en:"After Generation",kh:"បន្ទាប់ពីបង្កើត"},videoGenerationWarning:{en:"⚠️ Video generation may take 2-5 minutes. Credits will be deducted immediately.",kh:"⚠️ ការបង្កើតវីដេអូអាចចំណាយពេល ២-៥ នាទី។ ពិន្ទុនឹងត្រូវកាត់ភ្លាមៗ។"},cancel:{en:"Cancel",kh:"បោះបង់"},generateVideo:{en:"Generate Video",kh:"បង្កើតវីដេអូ"},multiFrameNeuralSynthesis:{en:"Multi-Frame Neural Synthesis",kh:"ការបង្កើតសរសៃប្រសាទពហុស៊ុម"},analyzingDepthLayers:{en:"Analyzing architectural depth layers...",kh:"កំពុងវិភាគស្រទាប់ជម្រៅស្ថាបត្យកម្ម..."},stabilizingGeometry:{en:"Stabilizing structural geometry...",kh:"កំពុងធ្វើឱ្យធរណីមាត្ររចនាសម្ព័ន្ធមានស្ថេរភាព..."},calculatingTrajectory:{en:"Calculating cinematic camera trajectory...",kh:"កំពុងគណនាគន្លងកាមេរ៉ាភាពយន្ត..."},simulatingDynamics:{en:"Simulating subtle environment dynamics (curtains, trees)...",kh:"កំពុងក្លែងធ្វើចលនាបរិស្ថានស៊ីជម្រៅ (វាំងនន, ដើមឈើ)..."},preservingFidelity:{en:"Preserving material and lighting fidelity...",kh:"កំពុងរក្សាភាពត្រឹមត្រូវនៃវត្ថុធាតុនិងពន្លឺ..."},finalizingConsistency:{en:"Finalizing frame-to-frame consistency...",kh:"កំពុងបញ្ចប់ភាពស៊ីសង្វាក់គ្នារវាងស៊ុម..."},duration:{en:"Duration",kh:"រយៈពេល"},videoHistory:{en:"Video History",kh:"ប្រវត្តិវីដេអូ"},clearVideoHistory:{en:"Clear All",kh:"លុបទាំងអស់"},confirmClearVideoHistory:{en:"Are you sure you want to clear all video history?",kh:"តើអ្នកប្រាកដថាចង់លុបប្រវត្តិវីដេអូទាំងអស់?"},download:{en:"Download",kh:"ទាញយក"},view:{en:"View",kh:"មើល"},delete:{en:"Delete",kh:"លុប"},veoWarningTitle:{en:"Important Notice",kh:"ការជូនដំណឹងសំខាន់"},veoWarningSubtitle:{en:"Veo 3.1 Pricing & AI Limitations",kh:"តម្លៃ Veo 3.1 និងដែនកំណត់ AI"},veoHighCostTitle:{en:"High Credit Cost",kh:"តម្លៃពិន្ទុខ្ពស់"},veoHighCostDesc:{en:"Veo 3.1 video generation consumes significantly more credits compared to other AI models. Each video can cost hundreds of credits depending on duration and resolution.",kh:"ការបង្កើតវីដេអូ Veo 3.1 ប្រើពិន្ទុច្រើនជាងម៉ូដែល AI ផ្សេងៗ។ វីដេអូនីមួយៗអាចចំណាយរាប់រយពិន្ទុអាស្រ័យលើរយៈពេលនិងគុណភាព។"},about:{en:"About",kh:"អំពីពួកយើង"},aboutTitle:{en:"About Sombok-Ai",kh:"អធិប្បាយអំពី សំបុក-អាយអាយ"},aboutTagline:{en:"The Future of Architectural Visualization",kh:"អនាគតនៃការបង្ហាញស្ថាបត្យកម្ម"},aboutMissionTitle:{en:"Our Mission",kh:"បេសកកម្មរបស់យើង"},aboutMissionDesc:{en:"Sombok-Ai is dedicated to empowering architects and designers with state-of-the-art Generative AI. We bridge the gap between imagination and reality, providing professional-grade visualization tools that are fast, intuitive, and accessible.",kh:"សំបុក-អាយអាយ ត្រូវបានបង្កើតឡើងដើម្បីផ្តល់អំណាចដល់ស្ថាបត្យករ និងអ្នករចនាម៉ូដជាមួយ AI កម្រិតខ្ពស់។ យើងតភ្ជាប់គម្លាតរវាងការស្រមៃ និងការពិត ដោយផ្តល់នូវឧបករណ៍បង្ហាញរូបភាពកម្រិតអាជីពដែលលឿន ងាយស្រួល និងអាចប្រើប្រាស់បានគ្រប់គ្នា។"},aboutVisionTitle:{en:"The Vision",kh:"ចក្ខុវិស័យ"},aboutVisionDesc:{en:"We believe AI should elevate human creativity, not replace it. Sombok-Ai is built to be a premium digital partner, helping you communicate your architectural stories with world-class visual quality.",kh:"យើងជឿជាក់ថា AI គួរតែលើកកម្ពស់ការច្នៃប្រឌិតរបស់មនុស្ស មិនមែនជំនួសវានោះទេ។ សំបុក-អាយអាយ ត្រូវបានបង្កើតឡើងដើម្បីក្លាយជាដៃគូឌីជីថលកម្រិតខ្ពស់ ជួយអ្នកក្នុងការបង្ហាញរឿងរ៉ាវស្ថាបត្យកម្មរបស់អ្នកជាមួយនឹងគុណភាពរូបភាពកម្រិតពិភពលោក។"},termsOfService:{en:"Terms of Service",kh:"លក្ខខណ្ឌប្រើប្រាស់"},privacyPolicy:{en:"Privacy Policy",kh:"គោលការណ៍ឯកជនភាព"},contactSupport:{en:"Contact Support",kh:"ទាក់ទងផ្នែកគាំទ្រ"},supportTitle:{en:"Sombok Support",kh:"ផ្នែកគាំទ្រសំបុក"},legal:{en:"Legal",kh:"ច្បាប់"},termsTitle:{en:"Terms of Service",kh:"លក្ខខណ្ឌប្រើប្រាស់"},privacyTitle:{en:"Privacy Policy",kh:"គោលការណ៍ឯកជនភាព"},contactUs:{en:"Contact Us",kh:"ទំនាក់ទំនងយើង"},materialDnaEditor:{en:"Material DNA Editor",kh:"កែសម្រួល Material DNA"},materialDnaSub:{en:"Refine AI Extraction for 1:1 Render Logic",kh:"កែសម្រួលការទាញយក AI សម្រាប់តក្កវិជ្ជា Render ១:១"},sceneAnalysisDetails:{en:"Scene Analysis Details",kh:"ព័ត៌មានលម្អិតនៃការវិភាគឆាក"},notForExterior:{en:"Not for Exterior",kh:"មិនមែនសម្រាប់ផ្នែកខាងក្រៅ"},layerLocked:{en:"Layer Locked",kh:"ស្រទាប់ត្រូវបានចាក់សោ"},editableLayer:{en:"Editable Layer",kh:"ស្រទាប់ដែលអាចកែសម្រួលបាន"},restrictedFeatureTitle:{en:"Feature Restricted",kh:"មុខងារត្រូវបានដាក់កំហិត"},restrictedFeatureDesc:{en:"DNA Analysis is strictly for Interior Scenes. This tool does not support Exterior architectural analysis.",kh:"ការវិភាគ DNA គឺសម្រាប់តែប្លង់ខាងក្នុងតែប៉ុណ្ណោះ។ ឧបករណ៍នេះមិនគាំទ្រការវិភាគស្ថាបត្យកម្មផ្នែកខាងក្រៅទេ។"},exteriorDetected:{en:"SCENE TYPE: EXTERIOR DETECTED",kh:"ប្រភេទឆាក៖ រកឃើញផ្នែកខាងក្រៅ"},aiThinking:{en:"AI is thinking...",kh:"AI កំពុងគិត..."},optimizationTip:{en:"Optimization Tip:",kh:"គន្លឹះបង្កើនប្រសិទ្ធភាព៖"},optimizationDesc:{en:'Review the materials above. If the AI detected "Concrete" but you want "Exposed Brick", simply change it here. This list guides the render engine to respect your existing space logic.',kh:'ពិនិត្យមើលសម្ភារៈខាងលើ។ ប្រសិនបើ AI រកឃើញថាជា "បេតុង" ប៉ុន្តែអ្នកចង់បាន "ឥដ្ឋ" សូមប្តូរវាត្រង់នេះ។ បញ្ជីនេះជួយឱ្យម៉ាស៊ីន Render គោរពតាមតក្កវិជ្ជានៃលំហរបស់អ្នក។'},discard:{en:"Discard",kh:"បោះបង់"},interiorOnlyFeature:{en:"Interior Only Feature",kh:"មុខងារសម្រាប់តែផ្នែកខាងក្នុង"},applyInstructions:{en:"Apply to Instructions",kh:"ដាក់ចូលក្នុងការណែនាំ"},instructionsActive:{en:"Active",kh:"សកម្ម"},materialDnaErrorExterior:{en:"Material DNA is not for Exterior scene",kh:"Material DNA មិនមែនសម្រាប់ប្លង់ខាងក្រៅទេ"},materialDnaApplied:{en:"Material DNA Applied",kh:"បានអនុវត្ត Material DNA"},dnaPlacesCount:{en:"{count} Places",kh:"{count} កន្លែង"},dnaSharedMaterialHint:{en:"Shared material — editing updates every active place at once",kh:"សម្ភារៈរួម — កែម្ដង អនុវត្តគ្រប់កន្លែងដែលបានបើក"},dnaPlaceExclude:{en:"Applied to {name} (click to exclude)",kh:"អនុវត្តលើ {name} (ចុចដើម្បីដកចេញ)"},dnaPlaceInclude:{en:"{name} excluded (click to include)",kh:"{name} ត្រូវបានដកចេញ (ចុចដើម្បីបញ្ចូលវិញ)"},dnaSplitPlace:{en:'Split "{name}" into its own material card',kh:'បំបែក "{name}" ទៅជាកាតសម្ភារៈដាច់ដោយឡែក'},editDna:{en:"Edit DNA",kh:"កែសម្រួល DNA"},configureEnvironmentLocation:{en:"Environment & location",kh:"បរិស្ថាន និងទីតាំង"},itemsSelectedCount:{en:"{count} items selected",kh:"បានជ្រើសរើស {count} មុខ"},addObjectsSubtext:{en:"Vehicles, plants & more",kh:"យានយន្ត រុក្ខជាតិ និងច្រើនទៀត"},selectLocation:{en:"Select Location",kh:"ជ្រើសរើសទីតាំង"},searchPlacePlaceholder:{en:"Search for a place (e.g., Eiffel Tower, Paris)",kh:"ស្វែងរកទីកន្លែង (ឧទាហរណ៍៖ ប៉ម Eiffel, ប៉ារីស)"},coordinatesLabel:{en:"Coordinates",kh:"កូអរដោនេ"},fetchingAddress:{en:"Fetching address...",kh:"កំពុងទាញយកអាសយដ្ឋាន..."},unknownLocation:{en:"Unknown location",kh:"មិនស្គាល់ទីតាំង"},mapSelectInstruction:{en:"Search or click on the map to select a location.",kh:"ស្វែងរក ឬចុចលើផែនទីដើម្បីជ្រើសរើសទីតាំង។"},confirmLocation:{en:"Confirm Location",kh:"បញ្ជាក់ទីតាំង"},locationNotFound:{en:"Location Not Found",kh:"រកមិនឃើញទីតាំង"},locationNotFoundDesc:{en:"Could not find the specified location. Please try a different search term.",kh:"រកមិនឃើញទីតាំងដែលបានបញ្ជាក់ទេ។ សូមសាកល្បងពាក្យស្វែងរកផ្សេងទៀត។"},searchFailed:{en:"Search Failed",kh:"ការស្វែងរកបរាជ័យ"},searchFailedDesc:{en:"Could not search for location. Please check your internet connection and try again.",kh:"មិនអាចស្វែងរកទីតាំងបានទេ។ សូមពិនិត្យការតភ្ជាប់អ៊ីនធឺណិតរបស់អ្នក ហើយព្យាយាមម្តងទៀត។"},locationAccessDenied:{en:"Location Access Denied",kh:"ការចូលប្រើទីតាំងត្រូវបានបដិសេធ"},locationAccessDeniedDesc:{en:"Please enable location access in your browser settings and try again.",kh:"សូមបើកការអនុញ្ញាតចូលប្រើទីតាំងនៅក្នុងការកំណត់កម្មវិធីរុករករបស់អ្នក ហើយព្យាយាមម្តងទៀត។"},veoAiMistakesTitle:{en:"AI May Make Mistakes",kh:"AI អាចធ្វើខុសពេលខ្លះ"},veoAiMistakesDesc:{en:"The AI is still in beta and may produce unexpected results, including artifacts, inconsistent motion, or hallucinations. Results may not always match your expectations.",kh:"AI នៅក្នុងដំណាក់កាល Beta និងអាចផ្តល់លទ្ធផលមិនរំពឹងទុក រួមទាំងបញ្ហាបច្ចេកទេស ចលនាមិនស៊ីសង្វាក់ ឬការបង្កើតមិនពិត។ លទ្ធផលអាចមិនតម្រូវតាមការរំពឹងរបស់អ្នក។"},veoRecommendationTitle:{en:"Our Recommendation",kh:"យោបល់របស់យើង"},veoRecommendationDesc:{en:"Consider testing with shorter durations and lower resolutions first. Save your credits for important projects where video is essential.",kh:"សូមពិចារណាសាកល្បងជាមួយរយៈពេលខ្លី និងគុណភាពទាបជាមុនសិន។ រក្សាទុកពិន្ទុរបស់អ្នកសម្រាប់គម្រោងសំខាន់ៗដែលវីដេអូចាំបាច់។"},veoUseOnlyNecessary:{en:"Use only when necessary.",kh:"ប្រើតែពេលចាំបាច់ប៉ុណ្ណោះ។"},veoUnderstand:{en:"I Understand",kh:"យល់ហើយ"},veoTooExpensive:{en:"Too Expensive",kh:"ថ្លៃម៉ែអាថ្លៃ"},sombokEditor:{en:"Sombok Editor",kh:"កម្មវិធីកែ សំបុក"},sombokEditorBeta:{en:"BETA",kh:"BETA"},sombokEditorSubtitle:{en:"AI-Powered Precision Editing Engine",kh:"ម៉ាស៊ីនកែរូបភាពដោយ AI"},paintToEdit:{en:"Paint Area to Edit",kh:"គូរផ្ទៃដើម្បីកែ"},editorAreaSelected:{en:"Area Selected",kh:"បានជ្រើសរើសផ្ទៃ"},editorPrompt:{en:"Edit Instructions",kh:"ការណែនាំកែប្រែ"},editorPromptPlaceholder:{en:"Describe what you want to change in the selected area...",kh:"ពិពណ៌នាអ្វីដែលអ្នកចង់ផ្លាស់ប្តូរក្នុងផ្ទៃដែលបានជ្រើសរើស..."},editorRequired:{en:"Required",kh:"ចាំបាច់"},editorOptional:{en:"Optional",kh:"ស្រេចចិត្ត"},textureReference:{en:"Texture Reference",kh:"រូបភាពយោងវាយនភាព"},objectReference:{en:"Object Reference",kh:"រូបភាពយោងវត្ថុ"},imageReference:{en:"Image Reference",kh:"រូបភាពយោង"},landscapeReference:{en:"Landscape Reference",kh:"រូបភាពយោងទេសភាព"},editorToolBrush:{en:"Brush",kh:"ជក់"},editorToolPen:{en:"Pen",kh:"ប៊ិច"},editorToolRect:{en:"Rect",kh:"ចតុកោណ"},editorToolText:{en:"Text",kh:"អត្ថបទ"},editorToolEraser:{en:"Eraser",kh:"ជ័រលុប"},editorBrushSize:{en:"Brush Size",kh:"ទំហំជក់"},editorDrawingToolkit:{en:"Mask Drawing Tools",kh:"ឧបករណ៍គូសសម្គាល់ផ្ទៃ"},editorDrawingToolkitHint:{en:"Paint target area on canvas",kh:"គូសលើផ្ទៃដែលចង់កែប្រែ"},editorAiModeTitle:{en:"AI Generation Mode",kh:"ទម្រង់កែប្រែ AI"},editorStudioSettings:{en:"Studio Settings",kh:"ការកំណត់ស្ទូឌីយោ"},editorGeneralModeLabel:{en:"General",kh:"ទូទៅ"},editorTextureModeLabel:{en:"Texture",kh:"វាយនភាព"},editorObjectModeLabel:{en:"Object",kh:"វត្ថុ"},editorImageModeLabel:{en:"Image",kh:"រូបភាពយោង"},editorLandscapeModeLabel:{en:"Landscape",kh:"ទេសភាព"},editorRemoveModeLabel:{en:"Remove",kh:"លុបចេញ"},editorReviseModeLabel:{en:"Revise",kh:"កែសម្រួលការរចនា"},editorRevisionReference:{en:"Revision Reference",kh:"រូបភាពយោងកែសម្រួល"},editorRevisionUploadLabel:{en:"Upload Revised Design",kh:"បញ្ចូលការរចនាកែសម្រួល"},editorRevisionUploadHint:{en:"Upload the client's revision to apply",kh:"បញ្ចូលការកែសម្រួលរបស់អតិថិជនដើម្បីអនុវត្ត"},editorRevisionGenerateLabel:{en:"Apply Design Revision",kh:"អនុវត្តការកែសម្រួលការរចនា"},editorRevisionGenerating:{en:"Rebuilding Design...",kh:"កំពុងបង្កើតការរចនាឡើងវិញ..."},editorGeneralModeBadge:{en:"✨ General",kh:"✨ ទូទៅ"},editorTextureModeBadge:{en:"🎨 Texture",kh:"🎨 វាយនភាព"},editorObjectModeBadge:{en:"📦 Object",kh:"📦 វត្ថុ"},editorImageModeBadge:{en:"🖼️ Image",kh:"🖼️ រូបភាពយោង"},editorLandscapeModeBadge:{en:"🌿 Landscape",kh:"🌿 ទេសភាព"},editorUploadGeneral:{en:"Upload Reference (Optional)",kh:"បញ្ចូលរូបភាពយោង (ស្រេចចិត្ត)"},editorUploadMaterial:{en:"Upload Material",kh:"បញ្ចូលសម្ភារៈ"},editorUploadObject:{en:"Upload Object",kh:"បញ្ចូលវត្ថុ"},editorUploadImage:{en:"Upload Image",kh:"បញ្ចូលរូបភាព"},editorUploadLandscape:{en:"Upload Landscape",kh:"បញ្ចូលទេសភាព"},editorGeneralPromptPlaceholder:{en:"Describe what to edit, change, or create in the painted area...",kh:"រៀបរាប់ពីអ្វីដែលត្រូវកែប្រែ ផ្លាស់ប្តូរ ឬបន្ថែមក្នុងតំបន់ដែលបានគូស..."},editorGeneralGenerateLabel:{en:"Edit",kh:"កែប្រែ"},editorRemovePromptLabel:{en:"Removal & Fill Instructions",kh:"ការណែនាំលុប និងបំពេញផ្ទៃ"},editorRemovePromptPlaceholder:{en:"Optional: Describe how to fill the background (e.g., continue wooden floor, clean asphalt, green lawn)...",kh:"ស្រេចចិត្ត៖ រៀបរាប់ពីរបៀបបំពេញផ្ទៃខាងក្រោយ (ឧទាហរណ៍៖ បន្តកម្រាលឈើ, ផ្លូវកៅស៊ូស្អាត, វាលស្មៅ)..."},editorFileLimit:{en:"JPEG, PNG up to 20MB",kh:"JPEG, PNG មិនលើស 20MB"},editorSynthesizing:{en:"Synthesizing...",kh:"កំពុងបង្កើត..."},editorInitiateEdit:{en:"Initiate Edit",kh:"ចាប់ផ្តើមកែប្រែ"},editorNeuralCost:{en:"Neural Cost",kh:"តម្លៃ Neural"},editorResolutionPricing:{en:"Resolution Pricing:",kh:"តម្លៃតាមគុណភាព៖"},editorResolutionPricingDesc:{en:"1K = 15 · 2K = 30 · 4K = 50 credits. Sombok Editor uses Nano Banana 2 for maximum precision.",kh:"1K = 15 · 2K = 30 · 4K = 50 ពិន្ទុ។ កម្មវិធីកែសំបុកប្រើ Nano Banana 2 សម្រាប់ភាពសុក្រិតបំផុត។"},editorModelNote:{en:"Sombok Editor is optimized for Nano Banana 2.",kh:"កម្មវិធីកែសំបុកត្រូវបានសម្រួលសម្រាប់ Nano Banana 2។"},postProdTitle:{en:"Sombok Post Production",kh:"បច្ចេកទេសរូបភាព សំបុក"},postProdSubtitle:{en:"Color Grading & Layout Engine",kh:"ម៉ាស៊ីនកំណត់ពណ៌ និងប្លង់រូបភាព"},postProdTypography:{en:"Typography Engine",kh:"ផ្នែកអក្សរ"},postProdTypographyOverlay:{en:"Typography Overlay",kh:"អក្សរលើរូបភាព"},postProdAddText:{en:"Add Text",kh:"បន្ថែមអក្សរ"},postProdNoLayers:{en:"No Text Layers",kh:"មិនទាន់មានអក្សរ"},postProdClickToStart:{en:"Double click the image or click '+ Add Text' to start.",kh:"ចុចពីរដងលើរូបភាព ឬចុច '+ បន្ថែមអក្សរ' ដើម្បីចាប់ផ្តើម។"},postProdFont:{en:"Font",kh:"ពុម្ពអក្សរ"},postProdColor:{en:"Color",kh:"ពណ៌"},postProdGradient:{en:"Gradient",kh:"ឆ្នូតពណ៌"},postProdShadow:{en:"Enable Drop Shadow",kh:"ដាក់ស្រមោលអក្សរ"},postProdStroke:{en:"Text Stroke",kh:"ឆ្នូតជុំវិញអក្សរ"},postProdOptions:{en:"Post Production Options",kh:"ជម្រើសកែរូបភាព"},postProdBrightness:{en:"Brightness",kh:"ពន្លឺ"},postProdContrast:{en:"Contrast",kh:"កម្រិតពន្លឺខ្មៅស"},postProdSaturation:{en:"Saturation",kh:"កម្រិតពណ៌"},postProdSharpness:{en:"Sharpness",kh:"ភាពច្បាស់"},postProdVignette:{en:"Vignette",kh:"គែមងងឹត"},postProdHighlightBurn:{en:"Highlight Burn",kh:"ការគ្រប់គ្រងពន្លឺខ្លាំង"},postProdColorMixer:{en:"Color Mixer",kh:"ឧបករណ៍លាយពណ៌"},postProdWatermark:{en:"Watermark / Logo",kh:"រូបសញ្ញា / Logo"},postProdUploadLogo:{en:"Upload Logo",kh:"បញ្ចូល Logo"},postProdFinalSave:{en:"Save Final Image",kh:"រក្សាទុករូបភាពចុងក្រោយ"},postProdInstruction:{en:"* Drag texts to move them. Drag the orange handle to scale. Double click anywhere to add new text.",kh:"* អូសអត្ថបទដើម្បីផ្លាស់ទី។ អូសចំណុចពណ៌ទឹកក្រូចដើម្បីពង្រីក/បង្រួម។ ចុចពីរដងដើម្បីបន្ថែមអត្ថបទថ្មី។"},postProdDetail:{en:"Detail",kh:"សេចក្តីលម្អិត"},postProdClarity:{en:"Clarity",kh:"ភាពស្រស់វាវ"},postProdTemperature:{en:"Temperature",kh:"សីតុណ្ហភាពពណ៌"},postProdBeforeAfter:{en:"Before / After",kh:"មុន / ក្រោយ"},postProdBefore:{en:"Before",kh:"មុន"},postProdAfter:{en:"After",kh:"ក្រោយ"},postProdUploadHeroTitle:{en:"Upload Architectural Image",kh:"បញ្ចូលរូបភាពស្ថាបត្យកម្ម"},postProdUploadHeroDesc:{en:"Drag & drop renders, photos, or sketches to enhance lighting, color grading, clarity, watermarks, and typography.",kh:"ទាញទម្លាក់រូបភាពស្ថាបត្យកម្ម រូបថត ឬគំនូរព្រាង ដើម្បីកែសម្រួលពន្លឺ ពណ៌ ភាពច្បាស់ Logo និងអក្សរ។"},postProdUseRecentRender:{en:"Or Select From Recent Architecture Renders",kh:"ឬជ្រើសរើសពីរូបភាពដែលបាន Render ថ្មីៗ"},postProdChangeImage:{en:"Upload New Image",kh:"បញ្ចូលរូបភាពថ្មី"},postProdResetAdjustments:{en:"Reset Adjustments",kh:"កំណត់ឡើងវិញទាំងអស់"},postProdApplyToBase:{en:"Apply to Base Image",kh:"កំណត់ជារូបភាពដើម"},postProdApplyAndReturn:{en:"Apply to Base Image",kh:"កំណត់ជារូបភាពដើម"},postProdAppliedSuccess:{en:"Applied to Base Image!",kh:"បានកំណត់ជារូបភាពដើម!"},postProdOverlayLayer:{en:"Storyboard & Image Layers",kh:"ផ្ទាំង Storyboard & ស្រទាប់រូបភាព"},postProdUseBaseModel:{en:"Use Base Image (Original)",kh:"យករូបភាពដើម (Base Image)"},postProdUploadOverlay:{en:"Upload Image Layer",kh:"បញ្ចូលរូបភាពជាន់ពីលើ"},postProdScale:{en:"Scale",kh:"ទំហំ"},postProdOpacity:{en:"Opacity",kh:"កម្រិតស្រាល/ច្បាស់"},postProdFrameStyle:{en:"Frame Style",kh:"រចនាប័ទ្មស៊ុម"},postProdFrameBrackets:{en:"Brackets (CAD/Focus)",kh:"ស៊ុមមុំ (Brackets)"},postProdFrameGlass:{en:"Glass Border",kh:"ស៊ុមបែបកញ្ចក់"},postProdFrameSolid:{en:"Solid Border",kh:"ស៊ុមពណ៌ស"},postProdFrameNone:{en:"No Border",kh:"គ្មានស៊ុម"},postProdStoryboardTitle:{en:"Storyboard & Image Layers",kh:"ផ្ទាំង Storyboard & ស្រទាប់រូបភាព"},postProdAddLayer:{en:"Add Image Layer",kh:"បន្ថែមស្រទាប់រូបភាព"},postProdNoImageLayers:{en:"No Image Layers Added",kh:"មិនទាន់មានស្រទាប់រូបភាព"},postProdStoryboardDesc:{en:"Add base sketches, renders, or floor plans to compose your storyboard presentation.",kh:"បន្ថែមគំនូរព្រាង រូប Render ឬប្លង់ស្ថាបត្យកម្ម ដើម្បីបង្កើត Storyboard បង្ហាញគម្រោង។"},postProdLayerOrder:{en:"Layer Order",kh:"លំដាប់ស្រទាប់"},postProdBgSettings:{en:"Canvas Background",kh:"ផ្ទៃខាងក្រោយផ្ទាំងគំនូរ"},postProdBgImage:{en:"Image Render",kh:"រូបភាព Render"},postProdBgSolid:{en:"Solid Color",kh:"ពណ៌សុទ្ធ (Solid Color)"},postProdCustomColor:{en:"Custom Color",kh:"ជ្រើសរើសពណ៌ផ្ទាល់ខ្លួន"},postProdCanvasRatio:{en:"Canvas Ratio",kh:"សមាមាត្រផ្ទាំង"},signEraseTitle:{en:"Erase Broken AI Text",kh:"លុបអក្សរ AI ដែលខុស"},signEraseDesc:{en:"Brush over garbled AI text in Editor to leave a clean blank wall/signboard before adding 3D text.",kh:"ប្រើជក់លុបអក្សរ AI ដែលខុសក្នុង Editor ដើម្បីទុកជញ្ជាំងឬផ្លាកទទេ មុនពេលដាក់អក្សរ 3D។"},signEraseButton:{en:"Erase in Editor",kh:"លុបក្នុង Editor"},signLighting:{en:"Scene Lighting",kh:"ពន្លឺទិដ្ឋភាព"},signDay:{en:"Day",kh:"ថ្ងៃ"},signNight:{en:"Night",kh:"យប់"},signText:{en:"Text Content",kh:"ខ្លឹមសារអត្ថបទ"},signStyle:{en:"Material & Style",kh:"សម្ភារៈ & រចនាប័ទ្ម 3D"},signPresetColorsNote:{en:"Colors are defined by the selected material preset.",kh:"ពណ៌ត្រូវបានកំណត់តាមសម្ភារៈ 3D ដែលបានជ្រើសរើស។"},signGoldStyle:{en:"Gold Style",kh:"ប្រភេទទឹកមាស"},signGoldMirror:{en:"Mirror Horizon",kh:"មាសកញ្ចក់ Horizon (ដូចរូប)"},signGoldRoyal:{en:"Royal Deep",kh:"មាសរាជវង្ស"},signGoldRose:{en:"Rose Gold",kh:"មាសផ្កាឈូក"},signGoldChampagne:{en:"Champagne",kh:"មាសស្រាល"},signGradientAngle:{en:"Gradient Angle",kh:"មុំចំណាំងពន្លឺ"},signHorizonPosition:{en:"Horizon Position",kh:"ទីតាំងបន្ទាត់កាត់ Horizon"},signGradientPreview:{en:"Face Gradient",kh:"ចំណាំងពន្លឺផ្ទៃមុខ"},signExtrusionReflection:{en:"3D Side Reflection",kh:"ចំណាំងពន្លឺជ្រុង 3D"},signOutline:{en:"Outer Stroke",kh:"ឆ្នូតគែម"},signStrokeGradient:{en:"Stroke Gradient",kh:"Gradient ឆ្នូតគែម"},signStrokeColor1:{en:"Color 1",kh:"ពណ៌ទី ១"},signStrokeColor2:{en:"Color 2",kh:"ពណ៌ទី ២"},signStrokeAngle:{en:"Stroke Angle",kh:"មុំឆ្នូតគែម"},sign3D:{en:"3D Extrusion",kh:"កម្រាស់ 3D"},signSideColor:{en:"Side Color",kh:"ពណ៌ចំហៀង"},signDepth:{en:"Depth",kh:"កម្រាស់"},signAngle:{en:"Light Angle",kh:"មុំពន្លឺ"},signBevel:{en:"Bevel Highlight",kh:"គែមចាំង Bevel"},signLed:{en:"LED Signage",kh:"ភ្លើង LED ផ្លាក"},signLedBack:{en:"Halo (Back)",kh:"បាញ់ក្រោយ (Halo)"},signLedFront:{en:"Front-Lit",kh:"បាញ់មុខ (Front)"},signLedNeon:{en:"Neon",kh:"នេអុង (Neon)"},signLedIntensity:{en:"Glow Intensity",kh:"កម្រិតពន្លឺ"},signLedSpread:{en:"Glow Spread",kh:"ទំហំពន្លឺផ្សាយ"},signLedOffset:{en:"Wall Gap",kh:"គម្លាតពីជញ្ជាំង"},signDayHint:{en:"Day mode: halo glow is dimmed for realism.",kh:"ទិដ្ឋភាពថ្ងៃ៖ ពន្លឺ LED ត្រូវបានបន្ថយដើម្បីភាពជាក់ស្តែង។"},signPerspective:{en:"3D Facade Perspective",kh:"មុំទស្សនវិស័យ 3D លើជញ្ជាំង"},signPerspectiveEdit:{en:"Adjust 4 Corners",kh:"កែសម្រួលជ្រុងទាំង 4"},signPerspectiveDone:{en:"Done Adjusting",kh:"រួចរាល់"},signPerspectiveHint:{en:"Drag the 4 cyan corner handles on the canvas to match the building facade or signboard angle.",kh:"អូសចំណុចពណ៌ខៀវទាំង 4 លើផ្ទាំងគំនូរដើម្បីតម្រឹមតាមមុំជញ្ជាំងអគារ ឬផ្លាក។"},signReset:{en:"Reset",kh:"កំណត់ឡើងវិញ"},signApplyWarning:{en:"Khmer 3D text is applied to base image. Note: Generating again with AI may alter the text. Re-add text after final render.",kh:"អក្សរ 3D ខ្មែរត្រូវបានដាក់លើរូបភាពដើម។ ចំណាំ៖ ការ Render ជាមួយ AI ម្តងទៀតអាចធ្វើឱ្យអក្សរប្រែប្រួល។ គួរបន្ថែមអក្សរក្រោយ Render ចប់។"}},Os={errorApiKey:{en:"API Key Required - Please set your Gemini API key in settings to start rendering.",kh:"ត្រូវការ API Key - សូមកំណត់ Gemini API key របស់អ្នកនៅក្នុងការកំណត់ ដើម្បីចាប់ផ្តើម។"},errorInvalidFile:{en:"Invalid File - Please select a valid image file (JPG, PNG, or WebP).",kh:"ឯកសារមិនត្រឹមត្រូវ - សូមជ្រើសរើសឯកសាររូបភាព"},errorAnalysis:{en:"Analysis Failed - Could not analyze your image. Please try again or use a different image.",kh:"បរាជ័យក្នុងការវិភាគរូបភាព។"},errorApiKeyInvalid:{en:"Invalid API Key - Your Gemini API key is not valid. Please check and update it in settings.",kh:"API key មិនត្រឹមត្រូវ។ សូមពិនិត្យមើល key របស់អ្នក។"},errorNoProductImage:{en:"Product Image Required - Please upload at least one product image to continue.",kh:"សូមបញ្ចូលរូបភាពផលិតផលជាមុនសិន។"},errorNoImage:{en:"Image Required - Please upload an image to start rendering.",kh:"សូមបញ្ចូលរូបភាពជាមុនសិន។"},errorNoPrompt:{en:"Rendering Settings Required - Please select a preset style or add custom instructions to continue.",kh:"មិនអាចបង្កើត Render Prompt បានទេ។ សូមជ្រើសរើស Preset ឬបន្ថែមការណែនាំ។"},errorNoPromptTitle:{en:"Configuration Required",kh:"ត្រូវការការណែនាំ"},apiKeyNetworkError:{en:"Network Error - Could not verify your API key. Please check your internet connection and try again.",kh:"មិនអាចផ្ទៀងផ្ទាត់សោបានទេ។ សូមពិនិត្យមើលការតភ្ជាប់បណ្តាញរបស់អ្នក ហើយព្យាយាមម្តងទៀត។"},errorRenderFailed:{en:"Rendering Failed - We couldn't generate your image. Your credits have been refunded.",kh:"បរាជ័យក្នុងការបង្ហាញ - យើងមិនអាចបង្កើតរូបភាពរបស់អ្នកបានទេ។"},errorSystemOverload:{en:"System Busy - Our servers are currently overloaded. Please try again in a few moments.",kh:"ប្រព័ន្ធកំពុងមមាញឹក - ម៉ាស៊ីនមេរបស់យើងកំពុងហួសទម្ងន់។"},errorTimeout:{en:"Request Timeout - The request took too long. Please try again. Your credits have been refunded.",kh:"អស់ពេល - សំណើចំណាយពេលយូរពេក។"},errorQuotaExceeded:{en:"Quota Exceeded - You've reached your API usage limit. Please upgrade your plan or try again later.",kh:"លើសកំណត់ - អ្នកបានឈានដល់កំណត់ការប្រើប្រាស់។"},errorImageTooLarge:{en:"Image Too Large - Your image is too large to process. Please use a smaller image (under 10MB).",kh:"រូបភាពធំពេក - ឯកសាររូបភាពរបស់អ្នកធំពេក។"},errorGeneric:{en:"Something Went Wrong - An unexpected error occurred. Please try again or contact support.",kh:"មានបញ្ហាកើតឡើង - កំហុសមិនរំពឹងទុកបានកើតឡើង។"},errorUpdateFailed:{en:"Update Failed - Could not save changes. Please check your connection and try again.",kh:"បរាជ័យ - មិនអាចរក្សាទុកបានទេ។"},errorLocationNotFound:{en:"Location Not Found - Could not find the specified location. Please try a different search.",kh:"រកមិនឃើញទីតាំង។"},errorLocationPermission:{en:"Location Permission Denied - Please enable location access in your browser settings.",kh:"បដិសេធការអនុញ្ញាតទីតាំង។"},errorUnauthorizedEmail:{en:"Your email is not authorized to use Sombok AI.",kh:"អ៊ីមែលរបស់អ្នកមិនត្រូវបានអនុញ្ញាតឱ្យប្រើ សំបុក AI ទេ។"},errorUserNotFoundWithPassword:{en:"No password account found for this email. Use email-only login or set a password first.",kh:"រកមិនឃើញគណនីដែលមានពាក្យសម្ងាត់សម្រាប់អ៊ីមែលនេះទេ។ សូមប្រើការចូលដោយអ៊ីមែលតែប៉ុណ្ណោះ ឬកំណត់ពាក្យសម្ងាត់ជាមុនសិន។"},errorWrongPassword:{en:"Incorrect password. Please try again or reset your password.",kh:"ពាក្យសម្ងាត់មិនត្រឹមត្រូវ។ សូមព្យាយាមម្តងទៀត ឬប្តូរពាក្យសម្ងាត់របស់អ្នក។"},errorUpgradeFailed:{en:"Failed to set password. Please try again.",kh:"បរាជ័យក្នុងការកំណត់ពាក្យសម្ងាត់។ សូមព្យាយាមម្តងទៀត។"},errorEmailAlreadyInUse:{en:"This email is already registered with a password.",kh:"អ៊ីមែលនេះមានគណនីពាក្យសម្ងាត់រួចហើយ។"},errorResetFailed:{en:"Failed to send reset email. Please check your email address.",kh:"បរាជ័យក្នុងការផ្ញើអ៊ីមែលប្តូរពាក្យសម្ងាត់។ សូមពិនិត្យអាសយដ្ឋានអ៊ីមែលរបស់អ្នក។"},resetEmailSent:{en:"Password reset email sent! Check your inbox.",kh:"អ៊ីមែលសម្រាប់ប្តូរពាក្យសម្ងាត់ត្រូវបានផ្ញើ! សូមពិនិត្យប្រអប់សំបុត្ររបស់អ្នក។"},passwordResetSent:{en:"Password reset email sent! Check your inbox.",kh:"អ៊ីមែលសម្រាប់ប្តូរពាក្យសម្ងាត់ត្រូវបានផ្ញើ! សូមពិនិត្យប្រអប់សំបុត្ររបស់អ្នក។"},upgradeSuccess:{en:"Account upgraded successfully! You can now login with your password.",kh:"ការតម្លើងគណនីបានជោគជ័យ! ឥឡូវនេះអ្នកអាចចូលប្រើជាមួយពាក្យសម្ងាត់របស់អ្នកបាន។"},setPassword:{en:"Set Password",kh:"កំណត់ពាក្យសម្ងាត់"},upgradeToPasswordAccount:{en:"Upgrade to Permanent Account",kh:"តម្លើងទៅគណនីអចិន្ត្រៃយ៍"},loginWithPassword:{en:"Login with Password",kh:"ចូលប្រើដោយពាក្យសម្ងាត់"}},Ps={setApiKeyPlaceholderTitle:{en:"Set Your API Key",kh:"កំណត់ API Key របស់អ្នក"},setApiKeyPlaceholderDesc:{en:"Please set your Gemini API key in the controls to begin.",kh:"សូមកំណត់ Gemini API Key របស់អ្នកក្នុងការកំណត់ដើម្បីចាប់ផ្តើម។"},uploadPlaceholderTitle:{en:"Upload an Image to Start",kh:"បញ្ចូលរូបភាពដើម្បីចាប់ផ្តើម"},uploadPlaceholderDesc:{en:"Your architectural visuals will appear here once processed.",kh:"រូបភាពស្ថាបត្យកម្មរបស់អ្នកនឹងបង្ហាញនៅទីនេះពេលដំណើរការរួច។"},styleReferenceDesc:{en:"Provide an image to influence the final style, color, and mood.",kh:"ផ្តល់រូបភាពដើម្បីជភិvឥទ្ធិពលលើរចនាប័ទ្ម, ពណ៌ និងអារម្មណ៍ចុងក្រោយ។"},styleStrength_0_25:{en:"Subtle Influence: Affects color palette and mood.",kh:"ឥទ្ធិពលស្រាល៖ ប៉ះពាល់លើពណ៌ និងអារម្មណ៍។"},styleStrength_26_60:{en:"Balanced Match: Matches overall style and color palette.",kh:"ការផ្គូផ្គងសមតុល្យ៖ ផ្គូផ្គងរចនាប័ទ្ម និងពណ៌ទូទៅ។"},styleStrength_61_85:{en:"Strong Emulation: Emulates distinct style, textures, and lighting.",kh:"ការត្រាប់តាមខ្លាំង៖ ត្រាប់តាមរចនាប័ទ្ម វាយនភាព និងពន្លឺ។"},styleStrength_86_100:{en:"Very Close Replication: Replicates style, composition, and textures.",kh:"ការចម្លងជិតស្និទ្ធ៖ ចម្លងរចនាប័ទ្ម សមាសភាព និងវាយនភាព។"},magicFillNote:{en:"Hold Ctrl/Cmd to add, Alt to subtract.",kh:"ចុច Ctrl/Cmd ដើម្បីបន្ថែម, Alt ដើម្បីដក"},creativityPrompt_0_20:{en:"Minimal Changes: Focuses on materials & colors. Camera view is locked.",kh:"ផ្លាស់ប្តូរតិចតួច៖ ផ្ដោតលើវត្ថុធាតុ & ពណ៌។ មុំកាមេរ៉ាត្រូវបានចាក់សោ។"},creativityPrompt_21_45:{en:"Subtle Modifications: Minor details & texture changes. Camera view is locked.",kh:"កែប្រែបន្តិចបន្តួច៖ បន្ថែមលម្អិត & វាយនភាព។ មុំកាមេរ៉ាត្រូវបានចាក់សោ។"},creativityPrompt_46_70:{en:"Balanced Design: Adds new elements, respects core structure. Camera view is flexible.",kh:"រចនាសមតុល្យ៖ បន្ថែមធាតុថ្មី តែរក្សារចនាសម្ព័ន្ធស្នូល។ មុំកាមេរ៉ាបត់បែន។"},creativityPrompt_71_90:{en:"Creative Exploration: Significant alterations to style. Camera view is flexible.",kh:"ស្វែងរករចនាប័ទ្មថ្មី៖ ផ្លាស់ប្តូររចនាប័ទ្មយ៉ាងសំខាន់។ មុំកាមេរ៉ាបត់បែន។"},creativityPrompt_91_100:{en:"Full Transformation: Maximum artistic freedom. Camera view is flexible.",kh:"ផ្លាស់ប្តូរទាំងស្រុង៖ សេរីភាពក្នុងការច្នៃប្រឌិតពេញលេញ។ មុំកាមេរ៉ាបត់បែន។"},interiorCreativity_0_20:{en:"Minimal Changes: Focuses on materials & textures. Layout and furniture are preserved.",kh:"ផ្លាស់ប្តូរតិចតួច៖ ផ្ដោតលើវត្ថុធាតុ & វាយនភាព។ រក្សាប្លង់ និងគ្រឿងសង្ហារឹម។"},interiorCreativity_21_45:{en:"Styling Update: Changes decor, lighting, and textiles. Core layout and furniture remain.",kh:"ការអាប់ដេតរចនាប័ទ្ម៖ ផ្លាស់ប្តូរការតុបតែង ពន្លឺ និងវាយនភ័ណ្ឌ។ ប្លង់ស្នូល និងគ្រឿងសង្ហារឹមនៅដដែល។"},interiorCreativity_46_70:{en:"Balanced Redesign: Replaces major furniture pieces. Layout is preserved.",kh:"ការរចនាឡើងវិញប្រកបដោយតុល្យភាព៖ ជំនួសគ្រឿងសង្ហារឹមសំខាន់ៗ។ ប្លង់ត្រូវបានរក្សាទុក។"},interiorCreativity_71_90:{en:"Major Overhaul: Changes all furniture and style. Architectural shell is recognizable.",kh:"ការផ្លាស់ប្តូរធំ៖ ផ្លាស់ប្តូរគ្រឿងសង្ហារឹម និងរចនាប័ទ្មទាំងអស់។ គ្រោងស្ថាបត្យកម្មអាចសម្គាល់បាន។"},interiorCreativity_91_100:{en:"Visionary Reimagination: Complete freedom to propose a new interior concept.",kh:"ការស្រមើស្រមៃប្រកបដោយចក្ខុវិស័យ៖ សេរីភាពពេញលេញក្នុងការเสนอแนวคิดខាងក្នុងថ្មី។"},promptDrawingPlaceholder:{en:"Describe what to draw or change",kh:"ពិពណ៌នាអ្វីដែលត្រូវគូរ ឬផ្លាស់ប្តូរ"},promptPlaceholder:{en:"e.g., 'a modern swimming pool with blue water'",kh:"ឧ. 'អាងហែលទឹកទំនើបមានទឹកពណ៌ខៀវ'"},promptAnalysisPlaceholder:{en:"Prompt will appear here...",kh:"ប្រអប់បញ្ចូលនឹងបង្ហាញនៅទីនេះ..."},promptUploadPlaceholder:{en:"Upload an image to auto-generate a prompt.",kh:"បញ្ចូលរូបភាពដើម្បីបង្កើតប្រអប់បញ្ចូល"},negativePromptPlaceholder:{en:"e.g., blurry, low quality, cartoon",kh:"ឧ. រូបមិនច្បាស់, គុណភាពទាប, តុក្កតា"},customObjectPlaceholder:{en:"Add custom objects... (e.g. a red bicycle)",kh:"បន្ថែមវត្ថុផ្ទាល់ខ្លួន... (ឧ. កង់ពណ៌ក្រហម)"},textureApplyPrompt:{en:"Applying texture to the selected area.",kh:"កំពុង​អនុវត្ត​វាយនភាព​ទៅ​ផ្ទៃ​ដែល​បាន​ជ្រើស។"},batchEnhanceDesc:{en:"Enhance multiple images at once using the prompt from the base image.",kh:"បង្កើនគុណភាពរូបភាពច្រើនក្នុងពេលតែមួយដោយប្រើប្រអប់បញ្ចូលពីរូបភាពដើម។"},batchPromptNotice:{en:"Prompt generalized for batch mode and is now editable for style consistency.",kh:"ប្រអប់បញ្ចូលត្រូវបានធ្វើឱ្យទូទៅសម្រាប់ Batch Mode ហើយឥឡូវអាចកែសម្រួលបានដើម្បីភាពស៊ីសង្វាក់គ្នានៃរចនាប័ទ្ម។"},skyReplacementDesc:{en:"Replace the sky in your image with a custom one. The AI will attempt to match lighting and perspective.",kh:"ជំនួសផ្ទៃមេឃក្នុងរូបភាពរបស់អ្នកជាមួយរូបផ្ទាល់ខ្លួន។ AI នឹងព្យាយាមផ្គូផ្គងពន្លឺ និងទស្សនីយភាព។"},skyReplacementPrompt:{en:"Replace the sky with the reference sky. Match lighting. Keep the building unchanged.",kh:"ជំនួសផ្ទៃមេឃជាមួយរូបភាពយោង។ ផ្គូផ្គងពន្លឺ។ រក្សាអគារឱ្យនៅដដែល។"},furnitureReplacementDesc:{en:"Upload images of new furniture to replace items in the base image. The AI will integrate them into the scene.",kh:"បញ្ចូលរូបភាពគ្រឿងសង្ហារឹមថ្មីដើម្បីជំនួសវត្ថុក្នុងរូបភាពដើម។ AI នឹងបញ្ចូលពួកវាទៅក្នុងទិដ្ឋភាព។"},furnitureReplacementPrompt:{en:"Replace current furniture with the provided items. Keep room architecture and lighting. Realistic shadows.",kh:"ជំនួសគ្រឿងសង្ហារឹមជាមួយវត្ថុដែលបានផ្តល់។ រក្សារចនាសម្ព័ន្ធនិងពន្លឺ។ ធានាឱ្យមានស្រមោលដូចពិត។"},replaceModelDesc:{en:"Upload a scene with a red highlighted area. The AI will place the model from your base image into that area and creatively blend it.",kh:"បញ្ចូលឆាកដែលមានផ្ទៃពណ៌ក្រហម។ AI នឹងដាក់ម៉ូដែលពីរូបភាពដើមរបស់អ្នកទៅក្នុងផ្ទៃនោះ ហើយបញ្ចូលវាដោយច្នៃប្រឌិត។"},replaceModelPrompt:{en:"Place the building from the model image into the red masked area. Match lighting and perspective.",kh:"ដាក់អគារពី 'រូបភាពម៉ូដែល' ចូលទៅក្នុងផ្ទៃពណ៌ក្រហម។ ផ្គូផ្គងពន្លឺ និងទស្សនវិស័យ។"},cameraAngleAnalysisPrompt:{en:"Analyze the camera perspective of this architectural image. Respond with only a short, descriptive phrase from the following list: 'eye-level shot', 'low-angle shot', 'high-angle shot', 'aerial view', 'drone view', 'top-down view', 'street-level view', 'worm's-eye view', 'three-quarter view'. Do not add any other words or punctuation.",kh:"វិភាគទស្សនវិស័យកាមេរ៉ានៃរូបភាពស្ថាបត្យកម្មនេះ។ ឆ្លើយតបដោយឃ្លាខ្លីៗពិពណ៌នាតែមួយពីបញ្ជីខាងក្រោម៖ 'ថតកម្រិតភ្នែក', 'ថតមុំទាប', 'ថតមុំខ្ពស់', 'មើលពីលើអាកាស', 'មើលពីដ្រូន', 'មើលពីលើត្រង់', 'មើលពីកម្រិតផ្លូវ', 'មើលពីក្រោម', 'មើលបីភាគបួន'។ កុំបន្ថែមពាក្យឬសញ្ញាវណ្ណយុត្តិផ្សេងទៀត។"},sceneRefDesc:{en:"Upload a scene. The AI will creatively place your product into it.",kh:"បញ្ចូលទិដ្ឋភាពមួយ។ AI នឹងដាក់ផលិតផលរបស់អ្នកចូលទៅក្នុងនោះដោយភាពចៃប្រឌិត។"},creativeFreedom_0_25:{en:"Realistic: Aims for a direct, believable replacement of an object.",kh:"ជាក់ស្តែង៖ មានគោលបំណងជំនួសវត្ថុដោយផ្ទាល់ និងគួរឱ្យជឿ។"},creativeFreedom_26_60:{en:"Integrated: Creatively blends the product, adjusting lighting/composition.",kh:"បញ្ចូលគ្នា៖ លាយបញ្ចូលផលិតផលប្រកបដោយភាពច្នៃប្រឌិត ដោយកែសម្រួលពន្លឺ និងសមាសភាព។"},creativeFreedom_61_85:{en:"Artistic: Re-interprets the scene to highlight the product dramatically.",kh:"សិល្បៈ៖ បកស្រាយទិដ្ឋភាពឡើងវិញ ដើម្បីរំលេចផលិតផលយ៉ាងខ្លាំង។"},creativeFreedom_86_100:{en:"Reimagined: Transforms the scene into a new, stunning visual concept.",kh:"ស្រមៃឡើងវិញ៖ បំប្លែងទិដ្ឋភាពទៅជាគំនិតរូបភាពថ្មីដ៏អស្ចារ្យ។"},customScenePlaceholder:{en:"Or describe a custom scene here... (overrides dropdown)",kh:"ឬពិពណ៌នាឆាកផ្ទាល់ខ្លួននៅទីនេះ... (នឹងជំនួសការជ្រើសរើសខាងលើ)"},customObjectPlaceholderProduct:{en:"e.g. water droplets, a sprig of mint",kh:"ឧ. ដំណក់ទឹក, ស្លឹកជីអង្កាម"},editImagePromptPlaceholder:{en:"e.g., 'add a cat sitting on the chair'",kh:"ឧ. 'បន្ថែមឆ្មាមួយក្បាលអង្គុយលើកៅអី'"},expandCanvasDesc:{en:"Expand the canvas and use AI to fill the new areas.",kh:"ពង្រីកផ្ទាំងក្រណាត់ ហើយប្រើ AI ដើម្បីបំពេញพื้นที่ใหม่។"},expandPrompt:{en:"Expand the image to fill the empty space. Extend the existing scene logic, textures, and lighting seamlessly.",kh:"ពង្រីករូបភាពដើម្បីបំពេញកន្លែងទំនេរ។ ពង្រីកតក្កវិជ្ជាឆាក វាយនភាព និងពន្លឺដែលមានស្រាប់យ៉ាងរលូន។"},seedPlaceholder:{en:"Random",kh:"ចៃដន្យ"},apiKeyDesc:{en:"To use this application, you need a free Gemini API key from Google AI Studio.",kh:"ដើម្បីប្រើកម្មវិធីនេះ អ្នកត្រូវការ Gemini API Key ឥតគិតថ្លៃពី Google AI Studio។"},apiKeyPlaceholder:{en:"Paste your API key here...",kh:"បិទភ្ជាប់ API Key របស់អ្នកនៅទីនេះ..."},apiKeyNote:{en:"Your key is saved locally in your browser and is not shared.",kh:"Key របស់អ្នកត្រូវបានរក្សាទុកក្នុង Browser របស់អ្នកតែប៉ុណ្ណោះ ហើយមិនត្រូវបានចែករំលែកទេ។"},welcomeDesc:{en:"Advanced AI-powered architectural visualization for professionals.",kh:"កម្មវិធីស្ថាបត្យកម្ម AI សម្រាប់អ្នកជំនាញ។"},welcomeFeature1Desc:{en:"Start with any architectural image—sketch, 3D model, or photo.",kh:"ចាប់ផ្តើមជាមួយរូបភាពស្ថាបត្យកម្មណាមួយ—គំនូរព្រាង, ម៉ូដែល 3D, ឬរូបថត។"},welcomeFeature2Desc:{en:"Fine-tune every detail from render style and materials to weather and lighting.",kh:"សម្រួលគ្រប់លម្អិតពីរចនាប័ទ្ម render និងវត្ថុធាតុដើម រហូតដល់អាកាសធាតុនិងពន្លឺ។"},welcomeFeature3Desc:{en:"Use the drawing tool to modify specific areas or redesign entire facades.",kh:"ប្រើឧបករណ៍គូរដើម្បីកែប្រែផ្នែកជាក់លាក់ ឬរចនាផ្នែកខាងមុខឡើងវិញទាំងស្រុង។"},usageLimitDesc:{en:"Approx. 40-45 generations per Gmail account per day.",kh:"ប្រហែល 40-45 រូបភាពក្នុងមួយថ្ងៃក្នុងមួយ Gmail។"},usageLimitNote:{en:"👉 Note: Use separate browser profiles for different accounts to avoid conflicts.",kh:"👉 ចំណាំ៖ ប្រើ profile Chrome ផ្សេងគ្នាដើម្បីជៀសវាងបញ្ហាគណនី។"},donateDesc:{en:"If you find this tool useful, please consider supporting its development. Your contribution helps keep the project alive and growing.",kh:"ប្រសិនបើអ្នកយល់ថាឧបករណ៍នេះមានប្រយោជន៍ សូមពិចារណាគាំទ្រការអភិវឌ្ឍន៍របស់វា។ ការរួមចំណែករបស់អ្នកជួយឱ្យគម្រោងនេះបន្តដំណើរការនិងរីកចម្រើន។"},donateScan:{en:"Scan with your banking app",kh:"ស្កេនជាមួយកម្មវិធីធនាគាររបស់អ្នក"},footerInspired:{en:"Inspired by SketchUp plugins, providing a simple way to enhance architectural visuals.",kh:"បង្កើតឡើងដោយមានការបំផុសគំនិតពីកម្មវិធីជំនួយរបស់ SketchUp ដោយផ្តល់នូវមធ្យោបាយងាយស្រួលក្នុងការបង្កើនគុណភាពរូបភាពស្ថាបត្យកម្ម។"},footerCopyright:{en:"All rights reserved.",kh:"រក្សាសិទ្ធិគ្រប់យ៉ាង។"},footerSupportDesc:{en:"Your support helps us maintain and improve this tool for everyone.",kh:"ការគាំទ្ររបស់អ្នកជួយយើងក្នុងការថែទាំ និងកែលម្អឧបករណ៍នេះសម្រាប់អ្នករាល់គ្នា។"}},Sn={photorealistic:"Exterior",landscapeDesign:"Landscape Design",facadeDesign:"Facade Design",threeDRender:"3D render",clayRender:"Clay Render",common:"Common",watercolor:"Watercolor",interiorDesign:"Interior Design",interiorRealEstate:"Interior Photography",isometric:"Isometric",axonometricView:"Axonometric View",architecturalPresentation:"Architectural Presentation",underConstruction:"Under Construction",woodenModel:"Wooden Model",explosionAnalysis:"Exploded Analysis",moodBoard:"Mood Board",moodBoardTitle:"Mood Boards",cameraMoodBoardFlatlay:"Tactile Flat-Lay Mood Board",cameraInteriorAxonometricAnalysis:"Interior Axonometric Analysis",technicalAnalysisTitle:"Technical Analysis",cameraInteriorStyleQuadComparison:"Style Comparison (4-Styles)",cameraInteriorGrid3x3:"Indoor Visualization Grid (3x3)",cameraInteriorProductBoard:"Product Presentation Board",tabRenovation:"Renovation",styleSeriesTitle:"Style Series",visualizationGridTitle:"Visualization Grids",productAnalysisTitle:"Product Analysis",renovationMergeDesignTitle:"Cabinet To Space",renovationMergeDesign:"Cabinet To Space",renovationExteriorTitle:"Exterior Renovation",renovationInteriorTitle:"Interior Renovation",renovationCleanupTitle:"Clearn room & Re-imagine",renovationMaterialRef:"Material Reference",renovationEmptyRoom:"Empty Room (De-clutter)",renovationCleanClutter:"Clean Room (Keep Furniture)",renovationRoomType:"Room Type",renovationStyle:"Design Style",renovationBuildingType:"Building Type",renovationExtStyle:"Architectural Style",renovationMultiRefTitle:"Moodboard to space",renovationMultiRefSubtitle:"AI Moodboard Synthesis",renovationMultiRefFigure:"Figure",renovationMultiRefAddImage:"+ Add Image",renovationMultiRefParams:"Synthesis Parameters",renovationMultiRefPrompt:"Custom Generation Prompt",renovationMultiRefExample:"Example: Please help me modify the space shown in Figure 1. The floor in Figure 1 should be changed to the floor shown in Figure 2...",renovationMultiRefNoRefs:"No references",studioArchitecturalModel:"Studio Model",presetNone:"None (Custom)",presetSketchupToReal:"Sketchup To Real",presetProxyToReal:"Proxy to Real",presetSbExterior:"Sb-Exterior",presetMansionPhotography:"Mansion Photography",presetRealisticMaterialRefinement:"Realistic Material Refinement",presetRealEstatePhoto:"Real Estate Photography type I",presetLessGreenRender:"Less-Green Render",presetMountainHillside:"HillSide Mountain Photography",presetMountainStream:"Stream Mountain Photography",presetLakeRelaxingVilla:"Lake Relaxing Villa",presetLakeHillside:"Lake-Side Hill Photography",presetRiceFieldHillside:"Rice Field",presetKohRongVilla:"Koh Rong Beach Villa",presetCoastalCliffRetreat:"Sea Mountain Photography",interiorPhotography:"Render-Interior",interiorPhotographyBase:"Interior Photography",interiorPresetTypeIII:"Interior Preset Type III",urbanNatureBalance:"Urban Nature Balance",dayScene:"Day Scene",morningVibe:"Morning Vibe",urbanRainyMood:"Urban Rainy Mood",presetFloorplanTo3D:"Floor Plan to 3D Top View",presetMasterPlan:"Master Plan",presetShopHouse:"Shop-House Photography",presetTownHouse:"Town-House Photography",presetTownHouseOp2:"Town-House Op2",presetCommercialPhotography:"Commercial Photography",presetMasterPlanTopView:"Masterplan 3D Top View",presetMasterPlanRealistic:"Masterplan Realistic",presetMasterPlanIllustration:"Masterplan Illustration",presetIsometricCutaway:"Isometric Cutaway 3D View",presetFloorplanColor2D:"2D Color Floor Plan",presetFloorplanSeries:"Floor Plan Series",rainTreeEstate:"Rain Tree Estate (New)",presetLiveMusicPub:"Live Music Pub",presetNoneDesc:"Manual control over all settings.",presetSketchupToRealDesc:"Transform 3D models into photorealistic renders. Automatically places greenery in logical zones while strictly omitting people and cars.",presetProxyToRealDesc:"Replaces all white/black box proxy placeholders with highly detailed, photorealistic 3D trees and plants while keeping the building geometry exact.",presetSbExteriorDesc:"Dramatic blue-hour twilight transformation with glowing warm interior lighting through windows, exterior column accent lights, and water reflections.",presetRealEstatePhotoTypeIII:"Real Estate Photography type III",presetRealEstatePhotoTypeIV:"Real Estate Photography type IV",presetRealEstatePhotoTypeIIIDesc:"Elegant mansion landscaping with stone pathways, grass between pavers, manicured hedges, ornamental trees, and sophisticated garden lighting. Evening ambiance with warm lights.",presetMansionPhotographyDesc:"Elegant mansion photography with refined landscaping, classical architectural elements, and premium estate atmosphere. Perfect for luxury residential projects with timeless design.",presetRealisticMaterialRefinementDesc:"Strictly preserves original geometry. Adds high-fidelity realistic textures, PBR materials, and professional lighting without structural changes.",presetRealEstatePhotoDesc:"Professional, bright real estate photography style.",presetRealEstatePhotoTypeII:"Real Estate Photography type II",presetRealEstatePhotoTypeIIDesc:"Premium villa with resort-style garden, manicured lawns, mature trees, colorful flowers, and luxury vehicles. Perfect for high-end residential properties.",presetRealEstatePhotoTypeIVDesc:"Exclusive gated community style with manicured emerald lawns, dense sculptural hedges, and high-end streetscapes. Features premium luxury SUVs and architectural lighting.",presetLessGreenRenderDesc:"Modern hardscape focus with minimal foreground greenery. Background trees only.",presetConstructionSite:"Construction Site",presetConstructionSiteDesc:"Newly-built house on bare soil with construction fence. No greenery, no tiles, natural dirt ground showing raw construction state.",presetMountainHillsideDesc:"Building dramatically perched on a hill slope, framed by mountains on both sides.",presetMountainStreamDesc:"A serene modern villa nestled by a rocky mountain stream with flowing water and lush forest.",presetLakeRelaxingVillaDesc:"A serene villa overlooking a calm, vast lake with a wooden pier and soft golden sunset lighting.",presetLakeHillsideDesc:"A premium villa perched on a sloping hillside with a direct panoramic view of a vast, peaceful lake.",presetRiceFieldHillsideDesc:"Dense healthy rice fields and rural Cambodian scenery with distant trees and houses on the horizon.",presetKohRongVillaDesc:"Luxury coastal villa on a pristine white sand beach with turquoise sea and tall leaning coconut palms.",presetCoastalCliffRetreatDesc:"Luxury villa perched on a rocky shoreline with turquoise waters, white sand, and majestic palm trees.",interiorPhotographyDesc:"High-end interior presentation. Bright, airy, and professional wide-angle look.",interiorPhotographyBaseDesc:"Base interior photography preset with professional lighting and realistic materials.",interiorPresetTypeIIIDesc:"High-end interior visualization with physically accurate PBR materials and professional architectural photography style.",urbanNatureBalanceDesc:"Frontal vista featuring a clean street, overhanging foliage, and artistic tree shadows casting on the pavement.",daySceneDesc:"Premium estate with Aston Martin Vantage, crisp daylight, and natural window reflections.",morningVibeDesc:"Premium estate with Bentley Continental GT Mulliner, crisp morning light, and lush resort-style garden.",urbanRainyMoodDesc:"Cinematic rainy city intersection with wet reflections and moody atmosphere.",presetFloorplanTo3DDesc:"Transform 2D floor plans into realistic 3D top-down interior renders.",presetMasterPlanDesc:"Cinematic large-scale layout visualization. Automatically adapts architecture and infrastructure to your selected Site Context.",presetMasterPlanTopViewDesc:"High-altitude 3D top-down render of your masterplan with realistic water and vegetation.",presetMasterPlanRealisticDesc:"Sophisticated realistic rendering for large-scale masterplan projects.",presetMasterPlanIllustrationDesc:"Clean, artistic architectural illustration style with vibrant colors and stylized elements.",presetIsometricCutawayDesc:"High-quality photorealistic 3D isometric cutaway based on floorplan with realistic lighting and materials.",presetFloorplanColor2DDesc:"Professional 2D color rendering of your floor plan with clean lines, bold walls, and light shading for depth.",presetShopHouseDesc:"Bustling urban street life with shop signage, cafe seating, Grab delivery riders, and cinematic motion blur.",presetTownHouseDesc:"Modern geometric town-house integrated into Phnom Penh urban rows. Features adjacent buildings and overcast lighting for realistic city integration.",presetTownHouseOp2Desc:"Precise replication of neighboring buildings on left and right sides to match source context exactly.",presetCommercialPhotographyDesc:"Smart AI population based on existing hardscape. Intelligently adds people, cars, and trees to your paved areas and plante