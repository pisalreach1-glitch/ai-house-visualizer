ipetBavetLogisticsHubMasterplan:"ប្លង់មេតំបន់ភស្តុភារកម្មប៉ោយប៉ែត / បាវិត (Cross-Border Hub)",ppapPortLogisticsCityMasterplan:"ប្លង់មេក្រុងភស្តុភារកម្មកំពង់ផែស្វយ័តភ្នំពេញ (PPAP LM17)",cameraRenovationFacade:"ការកែលំអរូបរាងខាងមុខ",cameraRenovationColor:"ការផ្លាស់ប្តូរពណ៌ និងសម្ភារៈខាងក្រៅ",cameraRenovationLandscape:"ការរៀបចំទេសភាពសួនជាថ្មី",cameraRenovationModern:"ការកែលំអផ្ទៃក្នុងបែបទំនើប",cameraRenovationMinimalist:"ការរៀបចំថ្មីបែបតិចតួច",cameraRenovationLayout:"ការបង្កើនប្រសិទ្ធភាពទីធ្លា",cameraRenovationExterior:"ការជួសជុលខាងក្រៅ",cameraRenovationInterior:"ការជួសជុលខាងក្នុង",searchObjectsPlaceholder:"ស្វែងរក ឬបន្ថែមវត្ថុតាមចំណង់ចំណូលចិត្ត..."},Ds={v3Title:{en:"Sombok AI 4.0 is Here",kh:"សំបុក AI ជំនាន់ 4.0 បានមកដល់ហើយ"},v3Subtitle:{en:"Experience the next generation of architectural AI with support for NanoBanana 2, NanoBanana Pro, ChatGPT Image 2, and SeeDream 5.0 Pro. More powerful, more precise, and faster than ever before.",kh:"បទពិសោធន៍បច្ចេកវិទ្យា AI ស្ថាបត្យកម្មជំនាន់ក្រោយជាមួយការគាំទ្រ NanoBanana 2, NanoBanana Pro, ChatGPT Image 2, និង SeeDream 5.0 Pro។ កាន់តែខ្លាំង កាន់តែត្រឹមត្រូវ និងលឿនជាងមុន។"},v3Badge:{en:"Major Update",kh:"បច្ចុប្បន្នភាពធំ"},fasterGeneration:{en:"Faster Generation",kh:"ការបង្កើតល្បឿនលឿន"},precisionModels:{en:"Precision Models",kh:"ម៉ូដែលច្បាស់លាស់"},lightingPhysics:{en:"Lighting Physics",kh:"រូបវិទ្យានៃពន្លឺ"},liveNow:{en:"Live Now",kh:"កំពុងដំណើរការ"},poweredByNextGenModels:{en:"Powered by Next-Gen Models",kh:"ដំណើរការដោយម៉ូដែលជំនាន់ក្រោយ"},landingPageTitle:{en:"Sombok AI - The Future of Architectural Visualization",kh:"សំបុក AI - អនាគតនៃការធ្វើបទបង្ហាញស្ថាបត្យកម្ម"},navFeatures:{en:"Features",kh:"លក្ខណៈពិសេស"},navPlugin:{en:"Plugin",kh:"Plugin"},navShowcase:{en:"Showcase",kh:"ស្នាដៃ"},navPricing:{en:"Pricing",kh:"តម្លៃ"},navFaq:{en:"FAQ",kh:"FAQ (សំណួរ)"},navTelegram:{en:"Telegram Channel",kh:"ឆានែល Telegram"},launchApp:{en:"Launch App",kh:"ចាប់ផ្តើមប្រើ"},heroBadge:{en:"AI-Powered Architectural Visualization",kh:"ការធ្វើបទបង្ហាញស្ថាបត្យកម្មដោយបញ្ញាសិប្បនិម្មិត"},heroTitleRow1:{en:"Cambodia's #1",kh:"លេខ ១ នៅកម្ពុជា"},heroTitleRow2:{en:"AI Visualizer",kh:"AI Visualizer"},heroDesc:{en:"Accelerate your design workflow. Transform hand sketches or raw 3D models into photorealistic renders instantly. No geometry distortion, just pure speed.",kh:"ពន្លឿនដំណើរការរចនារបស់អ្នក។ បំប្លែងគំនូរព្រាងដោយដៃ ឬម៉ូដែល 3D ទៅជារូបភាពប្រាកដនិយមភ្លាមៗ។ គ្មានការបង្ខូចទ្រង់ទ្រាយ ច្បាស់ និងរហ័សបំផុត។"},getStartedFree:{en:"Get Started",kh:"ចាប់ផ្តើម"},learnMore:{en:"Learn More",kh:"ស្វែងយល់បន្ថែម"},raw3DModel:{en:"Raw 3D Model",kh:"ម៉ូដែល 3D ដើម"},aiRendered:{en:"AI Rendered",kh:"Render ដោយ AI"},renderedWith:{en:"Rendered With",kh:"Render ជាមួយ"},ultraHighFidelity4K:{en:"Ultra High Fidelity 4K",kh:"កម្រិតច្បាស់បំផុត 4K"},powerfulFeatures:{en:"Powerful Features",kh:"លក្ខណៈពិសេសអស្ចារ្យ"},feature1Title:{en:"4K Rendering",kh:"Render កម្រិត 4K"},feature1Desc:{en:"Turn SketchUp screenshots or hand sketches into photorealistic 4K architectural renders with precise lighting and textures.",kh:"បំប្លែងរូបភាពពី SketchUp ឬគំនូរព្រាងដោយដៃ ទៅជារូបភាពស្ថាបត្យកម្មកម្រិត 4K ជាមួយពន្លឺ និងផ្ទៃសម្ភារៈច្បាស់ល្អ។"},feature2Title:{en:"Sombok Video",kh:"វីដេអូ សំបុក"},feature2Desc:{en:"Breathe life into your designs. Create cinematic walk-throughs and drone shots with our advanced Video-to-Video AI.",kh:"បន្ថែមជីវិតទៅក្នុងគំនូរប្លង់របស់អ្នក។ បង្កើតវីដេអូដើរឆ្លងកាត់ និងប្លង់ពីលើអាកាសជាមួយ Video-to-Video AI កម្រិតខ្ពស់របស់យើង។"},feature3Title:{en:"Perspective-Gallery",kh:"វិចិត្រសាលមុំកាមេរ៉ា"},feature3Desc:{en:"Automatically generate hundreds of alternative angles and detailed perspectives from just a single base image.",kh:"បង្កើតមុំកាមេរ៉ា និងទិដ្ឋភាពលម្អិតរាប់រយដោយស្វ័យប្រវត្តិពី រូបភាពមូលដ្ឋានត្រឹមតែមួយសន្លឹកប៉ុណ្ណោះ។"},feature4Title:{en:"Sombok Editor",kh:"សំបុក Editor"},feature4Desc:{en:"Precision AI editing. Selectively modify areas, swap objects, or perfect materials with our advanced masking and in-painting tools.",kh:"ការកែសម្រួលដោយ AI យ៉ាងត្រឹមត្រូវ។ កែប្រែតំបន់ដែលចង់បាន ប្តូរវត្ថុ ឬកែសម្ភារៈឱ្យល្អឥតខ្ចោះជាមួយឧបករណ៍ Masking និង In-painting។"},feature5Title:{en:"Sombok Renovation",kh:"សំបុក Renovation"},feature5Desc:{en:"Transform existing spaces. Redesign old buildings or interiors into modern masterpieces while maintaining structural integrity.",kh:"ផ្លាស់ប្តូរលំហដែលមានស្រាប់។ រចនាអាគារចាស់ ឬផ្ទៃខាងក្នុងឡើងវិញទៅជាស្នាដៃទំនើប ខណៈពេលដែលរក្សារចនាសម្ព័ន្ធដើម។"},feature6Title:{en:"AI Consistency",kh:"AI Consistency"},feature6Desc:{en:"Maintain design language across different views. Ensure materials, colors, and lighting remain identical throughout your entire project.",kh:"រក្សាភាសារចនាពេញមួយគម្រោង។ ធានាថាសម្ភារៈ ពណ៌ និងពន្លឺនៅតែដូចគ្នាគ្រប់មុំកាមេរ៉ា។"},feature7Title:{en:"Post Production",kh:"Post Production"},feature7Desc:{en:"Professional finishing touches. Fine-tune lighting, colors, and textures like Camera Raw in Photoshop with our AI post-processing suite.",kh:"ការតុបតែងចុងក្រោយកម្រិតអាជីព។ កែតម្រូវពន្លឺ ពណ៌ និងផ្ទៃសម្ភារៈ ដូចជា Camera Raw ក្នុង Photoshop ជាមួយឧបករណ៍ AI post-processing។"},extensionAvailable:{en:"Official SketchUp Extension",kh:"Extension ផ្លូវការសម្រាប់ SketchUp"},sketchupPluginTitle1:{en:"Sombok AI for",kh:"សំបុក AI សម្រាប់"},sketchupPluginTitle2:{en:"SketchUp",kh:"SketchUp"},sketchupPluginDesc:{en:"Supercharge your 3D workflow directly inside SketchUp. Lock active camera perspectives, sync viewport geometry with zero friction, and generate breathtaking photorealistic renders in seconds—without ever interrupting your design flow.",kh:"ពន្លឿនដំណើរការការងារ 3D របស់អ្នកផ្ទាល់ក្នុង SketchUp។ ចាក់សោមុំកាមេរ៉ាជាក់ស្តែង តភ្ជាប់ទិន្នន័យម៉ូដែលយ៉ាងរលូន និង Render រូបភាពស្ថាបត្យកម្មប្រណិតយ៉ាងឆាប់រហ័ស ដោយពុំចាំបាច់ចាកចេញពីផ្ទាំងការងាររបស់អ្នកឡើយ។"},lifetimeLicense:{en:"Lifetime License",kh:"អាជ្ញាប័ណ្ណប្រើប្រាស់ពេញមួយជីវិត"},oneClickExport:{en:"One-Click Viewport Sync",kh:"តភ្ជាប់ទិដ្ឋភាពក្នុង 1 ចុច"},recaptureView:{en:"Camera Angle & FOV Lock",kh:"ចាក់សោមុំកាមេរ៉ាច្បាស់លាស់"},instantRenderPipeline:{en:"Instant AI Render Pipeline",kh:"ដំណើរការ Render AI រហ័សទាន់ចិត្ត"},buyPlugin:{en:"Buy Plugin @sombokAi_official",kh:"ទិញ Plugin @sombokAi_official"},sombokLedBadge:{en:"SketchUp Lighting Extension",kh:"Extension ភ្លើងបំភ្លឺសម្រាប់ SketchUp"},sombokLedTitle1:{en:"Sombok LED",kh:"Sombok LED"},sombokLedTitle2:{en:"For SketchUp",kh:"សម្រាប់ SketchUp"},sombokLedDesc:{en:"Design stunning architectural lighting effortlessly inside SketchUp. Generate continuous LED strips, hidden ceiling coves, and custom neon profiles along any path or edge in a single click—ready for instant AI rendering.",kh:"រចនាប្រព័ន្ធភ្លើងបំភ្លឺស្ថាបត្យកម្មដ៏ទាក់ទាញយ៉ាងងាយស្រួលក្នុង SketchUp។ បង្កើតខ្សែភ្លើង LED ភ្លើងលាក់ពិដាន និងទម្រង់ភ្លើងតាមខ្សែបន្ទាត់ឬគែមនានាក្នុងមួយចុច សម្រាប់ការ Render AI កាន់តែរស់រវើក។"},sombokLedFeat1:{en:"One-Click LED Strip & Cove",kh:"បង្កើតខ្សែភ្លើង LED & ភ្លើងលាក់ក្នុង 1 ចុច"},sombokLedFeat2:{en:"Smart Path & Curve Follow",kh:"រត់តាមខ្សែបន្ទាត់ និងខ្សែកោងស្វ័យប្រវត្តិ"},sombokLedFeat3:{en:"Optimized for AI Rendering",kh:"ធ្វើឱ្យប្រសើរសម្រាប់ការ Render AI"},buyLedPlugin:{en:"Buy Sombok LED @sombokAi_official",kh:"ទិញ Sombok LED @sombokAi_official"},sombokSceneBadge:{en:"SketchUp Framing & Scene Manager",kh:"ឧបករណ៍គ្រប់គ្រង Scene & កាមេរ៉ាសម្រាប់ SketchUp"},sombokSceneTitle1:{en:"Sombok Scene",kh:"Sombok Scene"},sombokSceneTitle2:{en:"For SketchUp",kh:"សម្រាប់ SketchUp"},sombokSceneDesc:{en:"Master architectural composition and camera framing directly inside SketchUp. Set precise aspect ratios, custom focal lengths, safe frame masks, and manage multi-scene setups with one-click render readiness.",kh:"រៀបចំសមាសភាពប្លង់ និងមុំកាមេរ៉ាស្ថាបត្យកម្មយ៉ាងច្បាស់លាស់ក្នុង SketchUp។ កំណត់កម្រិតទំហំ Aspect Ratio, ប្រវែង Focal Length, របាំង Safe Frame និងគ្រប់គ្រងបណ្តុំ Scene ងាយស្រួលត្រៀម Render ក្នុង 1 ចុច។"},sombokSceneFeat1:{en:"Aspect Ratio & Safe Frame Mask",kh:"កំណត់ Aspect Ratio & Safe Frame ច្បាស់លាស់"},sombokSceneFeat2:{en:"Focal Length & Lens Presets",kh:"កំណត់ Focal Length & Lens កាមេរ៉ា"},sombokSceneFeat3:{en:"Multi-Scene Batch Sync",kh:"គ្រប់គ្រង និងតភ្ជាប់ Scene ទាំងអស់"},buyScenePlugin:{en:"Buy Sombok Scene @sombokAi_official",kh:"ទិញ Sombok Scene @sombokAi_official"},sombokEdgeBadge:{en:"SketchUp Geometry & Edge Suite",kh:"ឧបករណ៍គ្រប់គ្រង Edge & Geometry សម្រាប់ SketchUp"},sombokEdgeTitle1:{en:"Sombok Edge",kh:"Sombok Edge"},sombokEdgeTitle2:{en:"For SketchUp",kh:"សម្រាប់ SketchUp"},sombokEdgeDesc:{en:"Streamline your 3D geometry, smooth curved surfaces, and clean up messy linework with precision and speed. All-in-one edge control suite for SketchUp modelers, visualizers, and architects.",kh:"រៀបចំទម្រង់ 3D Geometry ឱ្យកាន់តែរលូន សម្រួលផ្ទៃកោង និងសម្អាតខ្សែបន្ទាត់រញ៉េរញ៉ៃយ៉ាងរហ័សនិងច្បាស់លាស់។ ឈុតឧបករណ៍គ្រប់គ្រងគែម និងបន្ទាត់ដ៏ពេញលេញសម្រាប់អ្នកប្រើប្រាស់ SketchUp។"},sombokEdgeFeat1:{en:"Interactive Soften & Smooth Panel",kh:"ផ្ទាំងកែសម្រួល Soften & Smooth ផ្ទាល់"},sombokEdgeFeat2:{en:"Smart Pick & Hide Line Loop Tool",kh:"ឧបករណ៍ Hide បន្ទាត់ & Loop ស្វ័យប្រវត្តិ"},sombokEdgeFeat3:{en:"One-Click Delete Coplanar Edges",kh:"លុបខ្សែបន្ទាត់ត្រួតស៊ីគ្នាក្នុង 1 ចុច"},getEdgePlugin:{en:"Get Sombok Edge @sombokAi_official",kh:"ទាញយក Sombok Edge @sombokAi_official"},masterpieceGallery:{en:"Masterpiece Gallery",kh:"វិចិត្រសាលស្នាដៃ"},createdBySombokUsers:{en:"Created by Sombok AI Users",kh:"បង្កើតឡើងដោយអ្នកប្រើប្រាស់ សំបុក AI"},viewCommunityGallery:{en:"View Community Gallery",kh:"មើលវិចិត្រសាលសហគមន៍"},getStartedHeader:{en:"Get Started with Sombok AI",kh:"ចាប់ផ្តើមជាមួយ សំបុក AI"},getStartedDesc:{en:"To ensure the highest quality of service and dedicated GPU resources, we require a one-time account registration.",kh:"ដើម្បីធានាបាននូវគុណភាពសេវាកម្មខ្ពស់បំផុត និងធនធាន GPU ជាក់លាក់ យើងតម្រូវឱ្យមានការចុះឈ្មោះគណនីតែម្តងប៉ុណ្ណោះ។"},mandatoryBadge:{en:"Mandatory for New Users",kh:"តម្រូវឱ្យមានសម្រាប់អ្នកប្រើប្រាស់ថ្មី"},fullAccessPassTitle:{en:"Full App Access Pass",kh:"សំបុត្រចូលប្រើកម្មវិធីពេញលេញ"},fullAccessPassDesc:{en:"Registration allows your email to be whitelisted for login and unlocks all professional features. Every pass includes complimentary credits to start rendering immediately.",kh:"ការចុះឈ្មោះអនុញ្ញាតឱ្យអ៊ីមែលរបស់អ្នកត្រូវបានបញ្ចូលក្នុងបញ្ជីអនុញ្ញាតសម្រាប់ការចូលប្រើ និងបើកមុខងារអាជីពទាំងអស់។ រាល់ការទិញរួមបញ្ចូលនូវ Credits ឥតគិតថ្លៃដើម្បីចាប់ផ្តើម Render ភ្លាមៗ។"},emailWhitelisting:{en:"Email Whitelisting",kh:"ការដាក់អ៊ីមែលក្នុងបញ្ជីអនុញ្ញាត"},startCredits500:{en:"500 Start Credits",kh:"៥០០ Credits ចាប់ផ្តើម"},access4KRendering:{en:"4K Rendering Access",kh:"ការចូលប្រើ 4K Rendering"},sombokVideoAIAccess:{en:"Sombok Video AI Access",kh:"ការចូលប្រើ សំបុក Video AI"},noSubscription:{en:"No Subscription",kh:"គ្មានការបង់ប្រាក់ប្រចាំខែ"},communitySupport:{en:"Community Support",kh:"ការគាំទ្រពីសហគមន៍"},oneTimeFee:{en:"One-Time Fee",kh:"បង់តែម្តងគត់"},buyAccessPass:{en:"Buy Access Pass",kh:"ទិញសំបុត្រចូលប្រើ"},existingUsersTopUp:{en:"Existing users top-up",kh:"សម្រាប់អ្នកប្រើប្រាស់ដែលមានស្រាប់"},tierStarter:{en:"Starter",kh:"Starter"},tierPopular:{en:"Popular ⭐",kh:"ការជ្រើសរើសច្រើន ⭐"},tierStudioPro:{en:"Studio Pro",kh:"Studio Pro"},tierEnterprise:{en:"Enterprise",kh:"Enterprise"},pkg1100Credits:{en:"1,000 Credits",kh:"១,០០០ Credits"},pkg500Credits:{en:"500 Credits",kh:"៥០០ Credits"},pkg2400Credits:{en:"2,000 Credits",kh:"២,០០០ Credits"},pkg5500Credits:{en:"5,500 Credits",kh:"៥,៥០០ Credits"},featUltraHighFidelity:{en:"Ultra-High Fidelity Renders",kh:"រូបភាព Render ច្បាស់បំផុត"},featArchGradeOutput:{en:"Architectural Grade Output",kh:"លទ្ធផលកម្រិតស្ថាបត្យកម្ម"},featStandardSpeed:{en:"Standard Processing Speed",kh:"ល្បឿនដំណើរការធម្មតា"},feat100Bonus:{en:"",kh:""},feat400Bonus:{en:"",kh:""},featPriorityGPU:{en:"Priority GPU Processing",kh:"អាទិភាពលើល្បឿន GPU"},featCommercialLicense:{en:"Commercial Usage License",kh:"អាជ្ញាប័ណ្ណប្រើប្រាស់ពាណិជ្ជកម្ម"},featPrioritySupport:{en:"24/7 Priority Support",kh:"ការគាំទ្រពិសេស ២៤/៧"},getStarterPack:{en:"Get Starter Pack",kh:"យកកញ្ចប់ Starter"},getPopularPack:{en:"Get Popular Pack",kh:"យកកញ្ចប់ Popular"},getStudioPro:{en:"Get Studio Pro",kh:"យកកញ្ចប់ Studio Pro"},getEnterprise:{en:"Get Enterprise Pack",kh:"យកកញ្ចប់ Enterprise"},mostPopular:{en:"Most Popular",kh:"ពេញនិយមបំផុត"},oneTime:{en:"One Time",kh:"តែម្តង"},faqTitle:{en:"FAQ",kh:"FAQ (សំណួរដែលសួរញឹកញាប់)"},faq1Q:{en:"What is sombokai?",kh:"តើអ្វីទៅជា sombokai?"},faq1A:{en:"sombokai is a premium generative AI platform specifically designed for architects and designers to create high-fidelity 4K renders and cinematic videos from sketches or simple 3D views.",kh:"sombokai គឺជាកម្មវិធីបញ្ញាសិប្បនិម្មិតកម្រិតខ្ពស់ដែលរចនាឡើងយ៉ាងពិសេសសម្រាប់ស្ថាបត្យករ និងអ្នករចនា ដើម្បីបង្កើតរូបភាព Render កម្រិត 4K និងវីដេអូភាពយន្តពីគំនូរព្រាង ឬទិដ្ឋភាព 3D សាមញ្ញ។"},faq2Q:{en:"Can I use sombokai without any AI knowledge?",kh:"តើខ្ញុំអាចប្រើ sombokai បានទេ បើគ្មានចំណេះដឹងផ្នែក AI?"},faq2A:{en:"Absolutely. Our platform is built for designers. Simply upload your base image, choose your style, and our AI handles all the complex rendering logic.",kh:"ពិតជាបាន។ កម្មវិធីរបស់យើងត្រូវបានបង្កើតឡើងសម្រាប់អ្នករចនា។ គ្រាន់តែបញ្ចូលរូបភាព ជ្រើសរើសរចនាប័ទ្ម ហើយ AI របស់យើងនឹងចាត់ចែងរាល់ការ Render ស្មុស្មាញទាំងអស់។"},faq3Q:{en:"Can I use the images I generated commercially?",kh:"តើខ្ញុំអាចប្រើរូបភាពដែលបានបង្កើតក្នុងគោលបំណងពាណិជ្ជកម្មបានទេ?"},faq3A:{en:"Yes. All images generated by our users are available for commercial use, including client presentations, portfolios, and marketing materials.",kh:"បាទ/ចាសបាន។ រាល់រូបភាពដែលបានបង្កើតអាចប្រើប្រាស់ក្នុងគោលបំណងពាណិជ្ជកម្ម រួមទាំងការបង្ហាញជូនអតិថិជន កម្រងស្នាដៃ និងសម្ភារៈទីផ្សារ។"},faq4Q:{en:"Can I use my 3D model from SketchUp, Rhino, Revit, or Archicad?",kh:"តើខ្ញុំអាចប្រើម៉ូដែល 3D ពី SketchUp, Rhino, Revit ឬ Archicad បានទេ?"},faq4A:{en:"Yes. You can use exported 2D views from any CAD or BIM software as a base image. Sombok AI will respect your proportions and geometry while adding photorealistic materials.",kh:"បាទ/ចាសបាន។ អ្នកអាចប្រើរូបភាព ២D ពីកម្មវិធី CAD ឬ BIM ណាមួយ។ សំបុក AI នឹងរក្សារូបរាង និងសមមាត្ររបស់អ្នក ខណៈពេលបន្ថែមសម្ភារៈរូបភាពឱ្យប្រាកដនិយម។"},faq5Q:{en:"Can I use sombokai for free?",kh:"តើខ្ញុំអាចប្រើ sombokai ហ្វ្រីបានទេ?"},faq5A:{en:"No. Sombok AI is a premium professional tool. New users are required to purchase a one-time App Access Pass for $25, which whitelists your email for login and includes 500 complimentary start credits.",kh:"ទេ! សំបុក AI ជាឧបករណ៍អាជីពកម្រិតខ្ពស់។ អ្នកប្រើប្រាស់ថ្មីត្រូវទិញសំបុត្រចូលប្រើកម្មវិធីតម្លៃ ២៥ ដុល្លារម្តងគត់ ដែលវានឹងបញ្ជូលអ៊ីមែលអ្នកក្នុងបញ្ជីប្រើប្រាស់ និងរួមបញ្ចូល ៥០០ Credits ឥតគិតថ្លៃ។"},ctaFinalTitle:{en:"Ready to Revolutionize Your Design?",kh:"ត្រៀមខ្លួនដើម្បីផ្លាស់ប្តូរការរចនារបស់អ្នកហើយឬនៅ?"},launchSombokNow:{en:"Launch Sombok AI Now",kh:"ចាប់ផ្តើមប្រើ សំបុក AI ឥឡូវនេះ"},footerTagline:{en:"Empowering the next generation of architects with Artificial Intelligence.",kh:"ពង្រឹងសមត្ថភាពស្ថាបត្យករជំនាន់ក្រោយជាមួយបញ្ញាសិប្បនិម្មិត។"},footerCopyright:{en:"Premium Architectural Solutions.",kh:"ដំណោះស្រាយស្ថាបត្យកម្មកម្រិតខ្ពស់។"},navAbout:{en:"About",kh:"អំពីយើង"},navTerms:{en:"Terms",kh:"លក្ខខណ្ឌ"},navPrivacy:{en:"Privacy",kh:"ឯកជនភាព"},navSupport:{en:"Support",kh:"គាំទ្រ"},navTutorials:{en:"Tutorials",kh:"មេរៀនបង្រៀន"},company:{en:"Company",kh:"ក្រុមហ៊ុន"},legal:{en:"Legal",kh:"ច្បាប់"},footerInspired:{en:"The future of architectural visualization is here. We empower designers with AI that respects geometry and accelerates creativity.",kh:"អនាគតនៃការធ្វើបទបង្ហាញស្ថាបត្យកម្មគឺនៅទីនេះ។ យើងពង្រឹងសមត្ថភាពអ្នករចនាជាមួយ AI ដែលគោរពតាមរូបរាងប្លង់ និងបង្កើនការច្នៃប្រឌិត។"},footerSupport:{en:"Community Support",kh:"ការគាំទ្រពីសហគមន៍"},footerSupportDesc:{en:"Join our official channels for tutorials, updates and direct help from our team.",kh:"ចូលរួមឆានែលផ្លូវការរបស់យើងសម្រាប់មេរៀន ព័ត៌មានថ្មីៗ និងការជំនួយផ្ទាល់ពីក្រុមការងារ។"},aboutTitle:{en:"About Us",kh:"អំពីយើង"},aboutTagline:{en:"AI Optimized for Architectural Design",kh:"AI ល្អបំផុតសម្រាប់ប្លង់ស្ថាបត្យកម្ម"},aboutMissionTitle:{en:"Our Mission",kh:"បេសកកម្មរបស់យើង"},aboutMissionDesc:{en:"To provide architects and designers with the most advanced AI rendering tools that are intuitive and powerful.",kh:"ផ្តល់ជូនស្ថាបត្យករ និងអ្នករចនានូវឧបករណ៍ Render AI កម្រិតខ្ពស់បំផុតដែលងាយស្រួលប្រើ និងមានប្រសិទ្ធភាព។"},aboutVisionTitle:{en:"Our Vision",kh:"ចក្ខុវិស័យរបស់យើង"},aboutVisionDesc:{en:"Creating a future where architectural visualization is limited only by imagination, not by technical barriers.",kh:"បង្កើតអនាគតមួយដែលការធ្វើបទបង្ហាញស្ថាបត្យកម្មត្រូវបានកំណត់ដោយការស្រមើស្រមៃប៉ុណ្ណោះ មិនមែនដោយឧបសគ្គបច្ចេកទេសឡើយ។"},aboutPhilosophyTitle:{en:"Our Philosophy",kh:"ទស្សនវិជ្ជារបស់យើង"},aboutPhilosophyDesc:{en:"We believe that AI should empower architects, not replace them, by turning technical complexity into creative simplicity.",kh:"យើងជឿជាក់ថា AI គួរតែផ្តល់អំណាចដល់ស្ថាបត្យករ មិនមែនជំនួសពួកគេឡើយ ដោយបំប្លែងភាពស្មុគស្មាញនៃបច្ចេកទេសទៅជាភាពសាមញ្ញនៃការច្នៃប្រឌិត។"},aboutGeminiOptimized:{en:"Optimized for Gemini 3 Pro",kh:"បង្កើនប្រសិទ្ធភាពសម្រាប់ Gemini 3 Pro"},aboutStayConnected:{en:"Stay Connected",kh:"រក្សាការទំនាក់ទំនង"},aboutFollowJourney:{en:"Follow our journey and get the latest updates.",kh:"តាមដានដំណើររបស់យើង និងទទួលបានព័ត៌មានថ្មីៗបំផុត។"},contactUs:{en:"Contact Us",kh:"ទាក់ទងមកយើង"},termsOfService:{en:"Terms of Service",kh:"លក្ខខណ្ឌប្រើប្រាស់"},effectiveDate:{en:"Effective Date: February 17, 2026",kh:"កាលបរិច្ឆេទមានប្រសិទ្ធភាព៖ ១៧ កុម្ភៈ ២០២៦"},terms1Title:{en:"1. Acceptance of Terms",kh:"១. ការទទួលយកលក្ខខណ្ឌ"},terms1Desc:{en:"By accessing or using Sombok AI, you agree to be bound by these Terms of Service and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site.",kh:"តាមរយៈការចូលប្រើ ឬប្រើប្រាស់ សំបុក AI អ្នកយល់ព្រមគោរពតាមលក្ខខណ្ឌប្រើប្រាស់ទាំងនេះ និងច្បាប់ និងបទប្បញ្ញត្តិជាធរមានទាំងអស់។ ប្រសិនបើអ្នកមិនយល់ព្រមជាមួយលក្ខខណ្ឌណាមួយទេ អ្នកត្រូវបានហាមឃាត់មិនឱ្យប្រើប្រាស់ ឬចូលប្រើគេហទំព័រនេះ។"},terms2Title:{en:"2. Use License",kh:"២. អាជ្ញាប័ណ្ណប្រើប្រាស់"},terms2Desc:{en:"Permission is granted to temporarily use Sombok AI for personal or commercial architectural visualization. This is the grant of a license, not a transfer of title, and under this license you may not:",kh:"ការអនុញ្ញាតត្រូវបានផ្តល់ឱ្យក្នុងប្រើប្រាស់ សំបុក AI ជាបណ្តោះអាសន្នសម្រាប់ការធ្វើបទបង្ហាញស្ថាបត្យកម្មផ្ទាល់ខ្លួន ឬពាណិជ្ជកម្ម។ នេះគឺជាការផ្តល់អាជ្ញាប័ណ្ណ មិនមែនជាការផ្ទេរកម្មសិទ្ធិឡើយ ហើយស្ថិតក្រោមអាជ្ញាប័ណ្ណនេះ អ្នកមិនអាច៖"},terms2List1:{en:"Modify or copy the materials for resale purposes.",kh:"កែប្រែ ឬចម្លងឯកសារសម្រាប់គោលបំណងលក់បន្ត។"},terms2List2:{en:"Attempt to decompile or reverse engineer any software contained on the platform.",kh:"ព្យាយាមសិក្សាពីរបៀបដំណើរការ ឬចម្លងកម្មវិធីដែលមាននៅលើវេទិកា។"},terms2List3:{en:"Remove any copyright or other proprietary notations from the materials.",kh:"លុបចោលរាល់កម្មសិទ្ធិបញ្ញា ឬការកត់សម្គាល់កម្មសិទ្ធិផ្សេងទៀតចេញពីឯកសារ។"},terms3Title:{en:"3. AI Generated Content",kh:"៣. ខ្លឹមសារដែលបង្កើតដោយ AI"},terms3Desc:{en:"Sombok AI uses generative artificial intelligence to create visualizations. While we strive for accuracy, we do not guarantee that the generated content will meet your specific requirements or be free of artifacts. Responsibility for the final architectural decisions remains with the user.",kh:"សំបុក AI ប្រើប្រាស់បញ្ញាសិប្បនិម្មិតដើម្បីបង្កើតរូបភាព។ ទោះបីជាយើងខិតខំដើម្បីភាពត្រឹមត្រូវក៏ដោយ យើងមិនធានាថាខ្លឹមសារដែលបានបង្កើតនឹងបំពេញតាមតម្រូវការជាក់លាក់របស់អ្នក ឬគ្មានកំហុសរូបភាពឡើយ។ ការទទួលខុសត្រូវចំពោះការសម្រេចចិត្តស្ថាបត្យកម្មចុងក្រោយនៅតែជាសិទ្ធិរបស់អ្នកប្រើប្រាស់។"},terms4Title:{en:"4. Account Inactivity & Deletion",kh:"៤. ភាពមិនសកម្មនៃគណនី និងការលុបចោល"},terms4Desc:{en:"To maintain system efficiency, Sombok AI reserves the right to remove user accounts and associated email addresses from our platform if the account has been inactive for more than 3 months (90 days) and no additional credits have been purchased during this period.",kh:"ដើម្បីរក្សាប្រសិទ្ធភាពនៃប្រព័ន្ធ សំបុក AI រក្សាសិទ្ធិក្នុងការលុបគណនីអ្នកប្រើប្រាស់ និងអាសយដ្ឋានអ៊ីមែលពាក់ព័ន្ធចេញពីវេទិការបស់យើង ប្រសិនបើគណនីនោះមិនសកម្មលើសពី ៣ ខែ (៩០ ថ្ងៃ) ហើយមិនមានការទិញ Credits បន្ថែមក្នុងអំឡុងពេលនេះ។"},terms5Title:{en:"5. Limitations",kh:"៥. ការកម្រិតទំនួលខុសត្រូវ"},terms5Desc:{en:"In no event shall Sombok AI or its suppliers be liable for any damages (including, without limitation, damages for loss of data or profit, or due to business interruption) arising out of the use or inability to use the materials on Sombok AI.",kh:"សំបុក AI ឬអ្នកផ្គត់ផ្គង់របស់ខ្លួននឹងមិនទទួលខុសត្រូវចំពោះការខូចខាតណាមួយ (រួមទាំង ប៉ុន្តែមិនកំណត់ចំពោះការខូចខាតសម្រាប់ការបាត់បង់ទិន្នន័យ ឬប្រាក់ចំណេញ ឬដោយសារការរំខានដល់អាជីវកម្ម) ដែលកើតចេញពីការប្រើប្រាស់ ឬអសមត្ថភាពក្នុងការប្រើប្រាស់សម្ភារៈនៅលើ សំបុក AI ឡើយ។"},privacyPolicy:{en:"Privacy Policy",kh:"គោលការណ៍ឯកជនភាព"},lastUpdated:{en:"Last Updated: February 17, 2026",kh:"កែប្រែចុងក្រោយ៖ ១៧ កុម្ភៈ ២០២៦"},privacy1Title:{en:"1. Information We Collect",kh:"១. ព័ត៌មានដែលយើងប្រមូល"},privacy1Desc:{en:"We collect information you provide directly to us, such as when you create an account, upload images, or communicate with us. This may include your email address, login information, and any images or prompts you submit to our AI services.",kh:"យើងប្រមូលព័ត៌មានដែលអ្នកផ្តល់ឱ្យយើងដោយផ្ទាល់ ដូចជាពេលអ្នកបង្កើតគណនី បញ្ចូលរូបភាព ឬទាក់ទងមកយើង។ វាអាចរួមបញ្ចូលអាសយដ្ឋានអ៊ីមែល ព័ត៌មានចូលប្រើ និងរាល់រូបភាព ឬការពិពណ៌នាដែលអ្នកផ្ញើទៅកាន់សេវាកម្ម AI របស់យើង។"},privacy2Title:{en:"2. How We Use Your Information",kh:"២. របៀបដែលយើងប្រើប្រាស់ព័ត៌មានរបស់អ្នក"},privacy2Desc:{en:"We use the information we collect to operate, maintain, and provide the features of Sombok AI. Specifically, images you upload are used solely to generate the requested visualizations and are processed securely. We do not sell your personal data to third parties.",kh:"យើងប្រើប្រាស់ព័ត៌មានដែលយើងប្រមូលដើម្បីដំណើរការ រក្សា និងផ្តល់នូវមុខងារនៃ សំបុក AI។ ជាពិសេស រូបភាពដែលអ្នកបញ្ចូលត្រូវបានប្រើសម្រាប់តែបង្កើតរូបភាពដែលអ្នកបានស្នើសុំប៉ុណ្ណោះ និងត្រូវបានដំណើរការដោយសុវត្ថិភាព។ យើងមិនលក់ទិន្នន័យផ្ទាល់ខ្លួនរបស់អ្នកទៅឱ្យភាគីទីបីឡើយ។"},privacy3Title:{en:"3. Data Security",kh:"៣. សុវត្ថិភាពទិន្នន័យ"},privacy3Desc:{en:"We implement a variety of security measures to maintain the safety of your personal information. Your data is stored on secure servers and we use industry-standard encryption protocols during transit.",kh:"យើងអនុវត្តនូវវិធានការសុវត្ថិភាពជាច្រើន ដើម្បីរក្សាសុវត្ថិភាពនៃព័ត៌មានផ្ទាល់ខ្លួនរបស់អ្នក។ ទិន្នន័យរបស់អ្នកត្រូវបានរក្សាទុកនៅលើសឺវើរដែលមានសុវត្ថិភាព ហើយយើងប្រើប្រាស់ពិធីការអ៊ិនគ្រីបតាមស្តង់ដារឧស្សាហកម្មអំឡុងពេលបញ្ជូន។"},privacy4Title:{en:"4. AI Training Policy",kh:"៤. គោលការណ៍បណ្តុះបណ្តាល AI"},privacy4Desc:{en:"By default, Sombok AI does not use your private uploads to train its underlying base models. Your project files remain yours.",kh:"តាមលំនាំដើម សំបុក AI មិនប្រើប្រាស់ការបញ្ជូលឯកជនរបស់អ្នកដើម្បីបណ្តុះបណ្តាលម៉ូដែលមូលដ្ឋានរបស់វាឡើយ។ ឯកសារគម្រោងរបស់អ្នកនៅតែជារបស់អ្នក។"},privacyFooter:{en:"Privacy is a fundamental right. We respect yours.",kh:"ឯកជនភាពគឺជាសិទ្ធិជាមូលដ្ឋាន។ យើងគោរពសិទ្ធិរបស់អ្នក។"},contactSupport:{en:"Contact Support",kh:"ទាក់ទងផ្នែកគាំទ្រ"},supportDesc:{en:"Our team is here to ensure you have the best experience with Sombok AI. Choose your preferred way to reach us.",kh:"ក្រុមការងាររបស់យើងនៅទីនេះដើម្បីធានាថាអ្នកមានបទពិសោធន៍ល្អបំផុតជាមួយ សំបុក AI។ ជ្រើសរើសវិធីសាស្ត្រដែលអ្នកពេញចិត្តដើម្បីទាក់ទងមកយើង។"},telegramTitle:{en:"Telegram",kh:"Telegram"},telegramDesc:{en:"Instant global support & community chat.",kh:"ការគាំទ្រជាសកល និងការជជែកក្នុងសហគមន៍ភ្លាមៗ។"},facebookTitle:{en:"Facebook",kh:"Facebook"},facebookDesc:{en:"Updates, tips, and direct messenger support.",kh:"ព័ត៌មានថ្មីៗ គន្លឹះ និងការគាំទ្រតាម Messenger ដោយផ្ទាល់។"},emailTitle:{en:"Email",kh:"អ៊ីមែល"},emailDesc:{en:"Official support for business inquiries.",kh:"ការគាំទ្រជាផ្លូវការសម្រាប់ការសាកសួរផ្នែកពាណិជ្ជកម្ម។"},supportHours:{en:"Support Hours: Monday - Friday | 8:00 AM - 6:00 PM (GMT+7)",kh:"ម៉ោងគាំទ្រ៖ ច័ន្ទ - សុក្រ | ៨:០០ ព្រឹក - ៦:០០ ល្ងាច (GMT+7)"},tutorialsTitle:{en:"Video Tutorials",kh:"វីដេអូបង្រៀន"},tutorialsSubtitle:{en:"Master Sombok AI with our step-by-step guides",kh:"ស្វែងយល់ពីរបៀបប្រើសំបុក AI ជាមួយវីដេអូណែនាំរបស់យើង"},watchTutorial:{en:"Watch Tutorial",kh:"មើលវីដេអូបង្រៀន"},tutorial1Title:{en:"Getting Started with Sombok AI",kh:"ចាប់ផ្តើមជាមួយសំបុក AI"},comingSoon:{en:"Coming Soon",kh:"នឹងមកដល់ក្នុងពេលឆាប់ៗនេះ"}},wi={},Us=new Set([...Object.keys(Sn),...Object.keys(Cn)]);for(const t of Us)wi[t]={en:Sn[t]||Cn[t]||t,kh:Cn[t]||Sn[t]||t};const Gs={..._s,...Os,...Ps,...wi,...Ds},Bs={apiKey:"AIzaSyCoM5mupqXdHvxR4aqsJd4OeppChAi2KMc",authDomain:"sombok3dplugin.firebaseapp.com",databaseURL:"https://sombok3dplugin-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"sombok3dplugin",storageBucket:"sombok3dplugin.firebasestorage.app",messagingSenderId:"930472937722",appId:"1:930472937722:web:d799a8571e31ac6f542143",measurementId:"G-SL4582QF1F"},Kr=rs(Bs),Ka=ns(Kr),Lt=is(Kr),Ze=os(Kr);ss(Kr);ls(Ze,vs);const Te={FLASH_BASE:5,PRO_3_BASE:25,PRO_3_2K:30,NANO_2_BASE:15,NANO_2_2K:30,NANO_21_BASE:15,NANO_21_2K:30,NANO_21_4K:50,PRO_4K_VAL:50,GPT_IMAGE_2_BASE:25,GPT_IMAGE_2_2K:30,GPT_IMAGE_2_4K:60,GPT_25_SUNBURST_BASE:25,GPT_25_SUNBURST_2K:30,GPT_25_SUNBURST_4K:60,GPT_25_FLARE_BASE:25,GPT_25_FLARE_2K:30,GPT_25_FLARE_4K:60,GPT_26_SUNBURST_BASE:25,GPT_26_SUNBURST_2K:30,GPT_26_SUNBURST_4K:60,ENV_EXTRACTION:5,VEO_BASE:60,KIE_SEEDREAM_BASE:25,KIE_SEEDREAM_2K:30,KIE_SEEDREAM_FLASH_2K:15,KIE_OMNI_VIDEO_4S:63,KIE_OMNI_VIDEO_6S:84,KIE_OMNI_VIDEO_8S:105,KIE_OMNI_VIDEO_10S:126,KIE_OMNI_VIDEO_12S:147,KIE_OMNI_VIDEO_15S:179},Ha=t=>t.toLowerCase().trim().replace(/[@.]/g,"_"),Gt=t=>{var s,o,c;if(t.type==="adjustment")return 0;if(t.type==="env_extraction")return Te.ENV_EXTRACTION;if(t.type==="video"){if(t.cost!==void 0)return t.cost;if(t.model==="kie-gemini-omni-video"||t.model==="google/gemini-omni-flash-1-2"||t.model==="google/gemini-omni-flash-1-1"||t.model==="gemi